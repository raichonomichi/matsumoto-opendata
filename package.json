{
  "name": "matsumoto-opendata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline:yamagoya": "tsx pipelines/build-yamagoya.ts",
    "pipeline:matsumoto-castle": "tsx pipelines/build-matsumoto-castle.ts",
    "pipeline:free-wifi": "tsx pipelines/build-free-wifi.ts",
    "pipeline:matsumoto-weather-history": "node --import tsx pipelines/build-matsumoto-weather-history.ts",
    "pipeline:population": "tsx pipelines/build-population.ts",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
