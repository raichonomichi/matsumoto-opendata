---
import DatasetAttribution from "@/components/DatasetAttribution.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  datasetIds?: string[];
  ogType?: "website" | "article";
}

const {
  title,
  description = "松本市オープンデータを活用した、すぐに使える1ページ完結型のミニサービス公開サイト。",
  datasetIds = [],
  ogType = "website",
} = Astro.props;

const siteName = "松本市オープンデータ活用サイト";
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "トップ" },
  { href: "/data/", label: "データ一覧" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 text-slate-900 hover:opacity-85">
          <img src="/favicon.svg" alt="" class="h-7 w-7" width="28" height="28" />
          <div class="leading-tight">
            <span class="block text-sm font-bold tracking-tight text-alps-950">
              松本市オープンデータ活用サイト
            </span>
            <span class="block font-mono text-[11px] text-slate-500">
              modata.raichonomichi.net
            </span>
          </div>
        </a>

        <nav aria-label="メインナビゲーション" class="flex items-center gap-1 sm:gap-2">
          {navItems.map((item) => {
            const isActive =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-1.5 text-sm font-medium transition",
                  isActive
                    ? "bg-alps-100 text-alps-900"
                    : "text-slate-600 hover:bg-slate-100 hover:text-slate-900",
                ]}
              >
                {item.label}
              </a>
            );
          })}
          <a
            href="https://github.com/raichonomichi/matsumoto-opendata"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6 sm:py-12">
      <slot />

      {datasetIds.length > 0 && (
        <div class="mt-12">
          <DatasetAttribution datasetIds={datasetIds} />
        </div>
      )}
    </main>

    <footer class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-xs text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="space-y-1">
          <p class="font-medium text-slate-800">
            松本市オープンデータ活用サイト（非公式・個人プロジェクト）
          </p>
          <p>
            本サイトは松本市等が公開するオープンデータを独自に加工・可視化して提供しています。最新かつ正確な情報は各公式配布元をご確認ください。
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-4">
          <a href="/data/" class="hover:text-alps-800 hover:underline">
            データ一覧
          </a>
          <a
            href="https://github.com/raichonomichi/matsumoto-opendata/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-alps-800 hover:underline"
          >
            アイデア・要望 (Issues)
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
