---
import DatasetAttribution from "@/components/DatasetAttribution.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  datasetIds?: string[];
  ogType?: "website" | "article";
}

const {
  title,
  description = "松本市オープンデータを活用した、すぐに使える1ページ完結型のミニサービス公開サイト。",
  datasetIds = [],
  ogType = "website",
} = Astro.props;

const siteName = "松本市オープンデータ活用サイト";
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "トップ" },
  { href: "/about/", label: "このサイトについて" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <header id="site-header" class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3.5 sm:px-6">
        <a href="/" class="flex min-w-0 items-center gap-2.5 text-slate-900 hover:opacity-85">
          <img src="/favicon.svg" alt="" class="h-7 w-7 shrink-0" width="28" height="28" />
          <div class="min-w-0 leading-tight">
            <span class="block truncate text-sm font-bold tracking-tight text-alps-950">
              松本市オープンデータ活用サイト
            </span>
            <span class="block truncate font-mono text-[11px] text-slate-500">
              modata.raichonomichi.net
            </span>
          </div>
        </a>

        <nav aria-label="メインナビゲーション" class="hidden items-center gap-1 sm:flex sm:gap-2">
          {navItems.map((item) => {
            const isActive =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-1.5 text-sm font-medium transition",
                  isActive
                    ? "bg-alps-100 text-alps-900"
                    : "text-slate-600 hover:bg-slate-100 hover:text-slate-900",
                ]}
              >
                {item.label}
              </a>
            );
          })}
          <a
            href="https://github.com/raichonomichi/matsumoto-opendata"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
          >
            GitHub
          </a>
        </nav>

        <button
          id="mobile-menu-button"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="メニューを開く"
          class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 sm:hidden"
        >
          <svg
            id="mobile-menu-icon-open"
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
          <svg
            id="mobile-menu-icon-close"
            class="hidden h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden border-t border-slate-200/80 bg-white sm:hidden">
        <nav aria-label="モバイルナビゲーション" class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-3">
          {navItems.map((item) => {
            const isActive =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-2.5 text-sm font-medium transition",
                  isActive
                    ? "bg-alps-100 text-alps-900"
                    : "text-slate-700 hover:bg-slate-100 hover:text-slate-900",
                ]}
              >
                {item.label}
              </a>
            );
          })}
          <a
            href="https://github.com/raichonomichi/matsumoto-opendata"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-900"
          >
            GitHub ↗
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6 sm:py-12">
      <slot />

      {datasetIds.length > 0 && (
        <div class="mt-12">
          <DatasetAttribution datasetIds={datasetIds} />
        </div>
      )}
    </main>

    <footer class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto flex max-w-5xl flex-col gap-8 px-4 py-10 text-xs text-slate-600 sm:flex-row sm:items-start sm:justify-between sm:px-6">
        <div class="max-w-md space-y-2">
          <p class="text-sm font-bold tracking-tight text-alps-950">
            松本市オープンデータ活用サイト（非公式・個人プロジェクト）
          </p>
          <p class="text-slate-700">
            <a
              href="https://raichonomichi.net/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-alps-800 hover:underline"
            >
              雷鳥の道
            </a>
            プロジェクト / 運営
            <a
              href="https://muchuu.net/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-alps-800 hover:underline"
            >
              muchuu.net
            </a>
          </p>
          <p class="leading-relaxed">
            本サイトは松本市等が公開するオープンデータを独自に加工・可視化して提供しています。最新かつ正確な情報は各公式配布元をご確認ください。
          </p>
        </div>
        <div class="grid shrink-0 grid-cols-2 gap-8 sm:gap-10">
          <nav aria-label="このサイト" class="space-y-2">
            <p class="text-[11px] font-semibold tracking-wider text-slate-500">
              このサイト
            </p>
            <ul class="space-y-1.5">
              <li>
                <a href="/about/" class="hover:text-alps-800 hover:underline">
                  このサイトについて
                </a>
              </li>
              <li>
                <a href="/open-data/" class="hover:text-alps-800 hover:underline">
                  松本市のオープンデータとは
                </a>
              </li>
              <li>
                <a href="/civic-tech/" class="hover:text-alps-800 hover:underline">
                  Civic Techとは
                </a>
              </li>
              <li>
                <a href="/data/" class="hover:text-alps-800 hover:underline">
                  データ一覧
                </a>
              </li>
              <li>
                <a
                  href="https://github.com/raichonomichi/matsumoto-opendata/issues"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-alps-800 hover:underline"
                >
                  アイデア・要望 (Issues)
                </a>
              </li>
            </ul>
          </nav>

          <nav aria-label="関連リンク" class="space-y-2">
            <p class="text-[11px] font-semibold tracking-wider text-slate-500">
              関連リンク
            </p>
            <ul class="space-y-1.5">
              <li>
                <a
                  href="https://raichonomichi.net/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-alps-800 hover:underline"
                >
                  雷鳥の道
                </a>
              </li>
              <li>
                <a
                  href="https://github.com/raichonomichi/matsumoto-opendata"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-alps-800 hover:underline"
                >
                  GitHub
                </a>
              </li>
              <li>
                <a
                  href="https://x.com/yytsuyuzaki"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-alps-800 hover:underline"
                >
                  運営者のX
                </a>
              </li>
              <li>
                <a
                  href="https://muchuu.net/contact/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-alps-800 hover:underline"
                >
                  お問い合わせ
                </a>
              </li>
              <li>
                <a href="/privacy/" class="hover:text-alps-800 hover:underline">
                  プライバシーポリシー
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const menuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");
      const openIcon = document.getElementById("mobile-menu-icon-open");
      const closeIcon = document.getElementById("mobile-menu-icon-close");

      function setMenuOpen(open: boolean): void {
        if (!menuButton || !mobileMenu) return;
        menuButton.setAttribute("aria-expanded", open ? "true" : "false");
        menuButton.setAttribute(
          "aria-label",
          open ? "メニューを閉じる" : "メニューを開く",
        );
        mobileMenu.classList.toggle("hidden", !open);
        openIcon?.classList.toggle("hidden", open);
        closeIcon?.classList.toggle("hidden", !open);
      }

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        setMenuOpen(!isOpen);
      });

      mobileMenu?.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setMenuOpen(false);
        }
      });

      document.addEventListener("click", (event) => {
        if (
          menuButton?.getAttribute("aria-expanded") === "true" &&
          event.target instanceof Node &&
          header &&
          !header.contains(event.target)
        ) {
          setMenuOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          menuButton?.getAttribute("aria-expanded") === "true"
        ) {
          setMenuOpen(false);
          menuButton.focus();
        }
      });
    </script>
  </body>
</html>
