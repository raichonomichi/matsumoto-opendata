---
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  computeSnapshotMetrics,
  formatYmJa,
  resolveComparisonSnapshot,
} from "@/lib/population-analytics";
import { populationDatasetSchema } from "@/lib/population-schema";

const rawJson = readFileSync(path.resolve("src/data/population.json"), "utf-8");
const dataset = populationDatasetSchema.parse(JSON.parse(rawJson));

const datasetIds = ["matsumoto-age-gender-population"];

const latestSnapshot = dataset.snapshots[dataset.snapshots.length - 1];
if (!latestSnapshot) {
  throw new Error("population.json has no snapshots");
}
const baseline2017 = resolveComparisonSnapshot(
  dataset.snapshots,
  latestSnapshot,
  "start_2017",
);
const latestMetrics = computeSnapshotMetrics(latestSnapshot);
const baselineMetrics = baseline2017
  ? computeSnapshotMetrics(baseline2017)
  : null;

const totalDiffVs2017 = baseline2017
  ? latestSnapshot.total - baseline2017.total
  : null;
const elderlyPctDiffVs2017 = baselineMetrics
  ? Math.round((latestMetrics.elderlyPct - baselineMetrics.elderlyPct) * 10) /
    10
  : null;

const years = dataset.range.years;
const months = Array.from({ length: 12 }, (_, idx) => idx + 1);

const useCases = [
  {
    title: "年代ごとの人口バランスと男女比を眺めたい時",
    description:
      "10歳階級・5歳階級・1歳刻みの3段階で人口ピラミッドを切り替えられ、どの世代にどれだけの人が暮らしているかを直感的に見渡せます。",
  },
  {
    title: "過去10年間の人口構造の変化を比べたい時",
    description:
      "2017年からの月次119時点のデータをスライダーやタイムラプス再生で動かしながら、基準年との輪郭重ね比較で増減の大きい世代を確認できます。",
  },
  {
    title: "特定の年代や3区分だけの長期推移を追いたい時",
    description:
      "「20代」「30代」などの年代や「年少・生産年齢・老年人口」のボタンを切り替えて、男女別の推移グラフと全人口に占める割合の変化を比較できます。",
  },
] as const;

const embeddedJson = JSON.stringify(dataset).replace(/</g, "\\u003c");
---

<BaseLayout
  title="松本市 人口ピラミッド・年代別グラフ"
  description="松本市の住民基本台帳に基づく年齢別（0〜109歳）・男女別人口（2017年〜2026年・月次119時点）を、人口ピラミッドと年代別推移グラフで切り替えて眺められます。"
  datasetIds={datasetIds}
>
  <div class="space-y-8">
    <!-- Hero -->
    <section class="rounded-3xl border border-alps-200 bg-gradient-to-br from-alps-950 via-alps-900 to-alps-800 px-6 py-9 text-white sm:px-9 sm:py-11">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-alps-200 ring-1 ring-white/15">
          松本市 住民基本台帳人口 10年アーカイブ
        </span>
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-alps-100 ring-1 ring-white/15">
          データ更新日: {dataset.generatedAt}
        </span>
      </div>

      <h1 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">
        松本市 人口ピラミッド・年代別グラフ
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-alps-100 sm:text-base">
        松本市が公開している「年齢別男女別人口」オープンデータ（平成29年〜令和8年・月次{" "}
        {dataset.range.snapshotCount}{" "}
        時点）を統合し、年代粒度の切り替え・過去比較・年代別の推移グラフを1ページでじっくり眺められる可視化ツールです。
      </p>

      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-2xl bg-white/10 px-4 py-3 ring-1 ring-white/15">
          <p class="text-[11px] text-alps-200">
            最新総人口（{formatYmJa(latestSnapshot.ym, false)}1日現在）
          </p>
          <p class="mt-0.5 text-lg font-bold">
            {latestSnapshot.total.toLocaleString("ja-JP")} 人
          </p>
          <p class="mt-0.5 text-[11px] text-alps-200">
            男 {latestSnapshot.male.toLocaleString("ja-JP")} 人 / 女{" "}
            {latestSnapshot.female.toLocaleString("ja-JP")} 人
            {totalDiffVs2017 !== null &&
              `（2017年同月比 ${totalDiffVs2017 >= 0 ? "+" : ""}${totalDiffVs2017.toLocaleString("ja-JP")}人）`}
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 px-4 py-3 ring-1 ring-white/15">
          <p class="text-[11px] text-alps-200">
            高齢化率（65歳以上・{formatYmJa(latestSnapshot.ym, false)}）
          </p>
          <p class="mt-0.5 text-lg font-bold">
            {latestMetrics.elderlyPct.toFixed(1)}%
            <span class="ml-1 text-xs font-normal text-alps-200">
              （{latestMetrics.elderlyCount.toLocaleString("ja-JP")} 人）
            </span>
          </p>
          <p class="mt-0.5 text-[11px] text-alps-200">
            年少 {latestMetrics.youthPct.toFixed(1)}% / 生産年齢{" "}
            {latestMetrics.workingPct.toFixed(1)}%
            {elderlyPctDiffVs2017 !== null &&
              `（2017年比 ${elderlyPctDiffVs2017 >= 0 ? "+" : ""}${elderlyPctDiffVs2017.toFixed(1)}pt）`}
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 px-4 py-3 ring-1 ring-white/15">
          <p class="text-[11px] text-alps-200">収録アーカイブ期間</p>
          <p class="mt-0.5 text-lg font-bold">
            {formatYmJa(dataset.range.startYm, false)}〜
            {formatYmJa(dataset.range.endYm, false)}
          </p>
          <p class="mt-0.5 text-[11px] text-alps-200">
            全 {dataset.range.snapshotCount} か月分 × 0歳〜{dataset.maxAge}歳（1歳刻み）
          </p>
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section aria-labelledby="use-cases-heading" class="space-y-3">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2
          id="use-cases-heading"
          class="text-base font-bold text-slate-900 sm:text-lg"
        >
          こんな時に使えます
        </h2>
        <p class="text-xs text-slate-500">
          松本市の世代構成・少子高齢化の推移・男女別バランスの確認向け
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        {useCases.map((item) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <h3 class="text-sm font-bold text-alps-950">{item.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Notice & Official Links -->
    <aside
      aria-label="統計データの前提と公式案内"
      class="rounded-2xl border border-amber-200 bg-amber-50/70 px-5 py-4 text-xs leading-relaxed text-amber-950 sm:text-sm"
    >
      <p class="font-semibold text-amber-900">
        データの基準・集計仕様について
      </p>
      <p class="mt-1 text-amber-900/90">{dataset.notice}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href={dataset.officialLinks.portal}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg bg-amber-900 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-amber-800"
        >
          松本市オープンデータ公式一覧 ↗
        </a>
        <a
          href={dataset.officialLinks.latestWork}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg border border-amber-300 bg-white px-3 py-1.5 text-xs font-semibold text-amber-950 transition hover:bg-amber-100"
        >
          LinkData.org 最新年（令和8年）ワーク ↗
        </a>
      </div>
    </aside>

    <!-- Section 1: Population Pyramid -->
    <section
      aria-labelledby="pyramid-heading"
      class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="pyramid-heading" class="text-lg font-bold text-slate-900 sm:text-xl">
            1. 人口ピラミッド（年代・時点・比較の切り替え）
          </h2>
          <p class="mt-1 text-xs text-slate-600">
            左が男性、右が女性です。年代の粒度や時点を切り替えたり、年代バーをクリックして下の推移グラフと連動させたりできます。
          </p>
        </div>
        <div class="rounded-xl bg-alps-50 px-3.5 py-2 text-right ring-1 ring-alps-200">
          <p class="text-[11px] font-medium text-alps-700">表示中の時点</p>
          <p
            id="pyramid-current-label"
            class="text-sm font-bold text-alps-950"
          >
            {formatYmJa(latestSnapshot.ym)} 1日現在
          </p>
        </div>
      </div>

      <!-- Controls -->
      <div class="mt-4 space-y-4 rounded-2xl border border-slate-200/80 bg-slate-50/80 p-4">
        <div class="grid gap-4 lg:grid-cols-3">
          <div>
            <p class="text-xs font-semibold text-slate-700">年代の粒度</p>
            <div
              class="mt-2 flex flex-wrap gap-1.5"
              role="group"
              aria-label="年代の粒度切替"
            >
              <button
                type="button"
                data-granularity-btn="decade"
                aria-pressed="true"
                class="rounded-xl bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
              >
                10歳階級（年代別）
              </button>
              <button
                type="button"
                data-granularity-btn="five_year"
                aria-pressed="false"
                class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
              >
                5歳階級
              </button>
              <button
                type="button"
                data-granularity-btn="single"
                aria-pressed="false"
                class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
              >
                1歳刻み
              </button>
            </div>
          </div>

          <div>
            <p class="text-xs font-semibold text-slate-700">過去比較の重ね線</p>
            <div
              class="mt-2 flex flex-wrap gap-1.5"
              role="group"
              aria-label="過去比較オーバーレイ切替"
            >
              <button
                type="button"
                data-compare-btn="start_2017"
                aria-pressed="true"
                class="rounded-full bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
              >
                2017年同月
              </button>
              <button
                type="button"
                data-compare-btn="five_years_ago"
                aria-pressed="false"
                class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
              >
                5年前同月
              </button>
              <button
                type="button"
                data-compare-btn="prev_year"
                aria-pressed="false"
                class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
              >
                前年同月
              </button>
              <button
                type="button"
                data-compare-btn="none"
                aria-pressed="false"
                class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
              >
                比較なし
              </button>
            </div>
          </div>

          <div>
            <p class="text-xs font-semibold text-slate-700">横軸スケール</p>
            <div
              class="mt-2 flex flex-wrap gap-1.5"
              role="group"
              aria-label="横軸スケール切替"
            >
              <button
                type="button"
                data-axis-btn="fixed"
                aria-pressed="true"
                class="rounded-full bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
              >
                軸を全期間で固定
              </button>
              <button
                type="button"
                data-axis-btn="auto"
                aria-pressed="false"
                class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
              >
                表示時点に最適化
              </button>
            </div>
          </div>
        </div>

        <!-- Year & Month Selection + Timelapse -->
        <div class="border-t border-slate-200/80 pt-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="年を切り替え">
              <span class="mr-1 text-xs font-semibold text-slate-700">年:</span>
              {years.map((y) => {
                const isInitial = y === latestSnapshot.year;
                return (
                  <button
                    type="button"
                    data-year-btn={String(y)}
                    aria-pressed={isInitial ? "true" : "false"}
                    class:list={[
                      "rounded-lg px-2.5 py-1 text-xs transition",
                      isInitial
                        ? "bg-alps-900 font-semibold text-white"
                        : "border border-slate-300 bg-white font-medium text-slate-700 hover:border-alps-400 hover:text-alps-900",
                    ]}
                  >
                    {y}年
                  </button>
                );
              })}
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <label
                for="month-select"
                class="text-xs font-semibold text-slate-700"
              >
                月:
              </label>
              <select
                id="month-select"
                class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-800 focus:border-alps-500 focus:outline-none"
              >
                {months.map((m) => (
                  <option value={String(m)} selected={m === latestSnapshot.month}>
                    {m}月（1日現在）
                  </option>
                ))}
              </select>
            </div>
          </div>

          <p
            id="year-month-clamp-note"
            class="mt-2 hidden text-[11px] font-medium text-amber-800"
          />

          <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
            <div class="flex flex-1 items-center gap-3">
              <span class="shrink-0 font-mono text-[11px] text-slate-500">
                {dataset.range.startYm}
              </span>
              <input
                id="timeline-slider"
                type="range"
                min="0"
                max={String(dataset.snapshots.length - 1)}
                value={String(dataset.snapshots.length - 1)}
                aria-label="表示年月スライダー"
                class="h-2 w-full cursor-pointer accent-alps-700"
              />
              <span class="shrink-0 font-mono text-[11px] text-slate-500">
                {dataset.range.endYm}
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <button
                id="play-toggle-btn"
                type="button"
                aria-pressed="false"
                class="inline-flex items-center rounded-xl bg-alps-800 px-3.5 py-1.5 text-xs font-semibold text-white transition hover:bg-alps-700"
              >
                ▶ 10年変化を再生
              </button>
              <div
                class="inline-flex rounded-xl border border-slate-300 bg-white p-0.5 text-[11px]"
                role="group"
                aria-label="再生ステップ切替"
              >
                <button
                  type="button"
                  data-play-mode-btn="annual"
                  aria-pressed="true"
                  class="rounded-lg bg-alps-900 px-2.5 py-1 font-semibold text-white transition"
                >
                  年次
                </button>
                <button
                  type="button"
                  data-play-mode-btn="monthly"
                  aria-pressed="false"
                  class="rounded-lg px-2.5 py-1 font-medium text-slate-600 transition hover:text-slate-900"
                >
                  月次
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Summary Cards for Selected Snapshot -->
      <div
        id="summary-cards"
        class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4"
      >
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5">
          <p class="text-[11px] font-medium text-slate-500">総人口</p>
          <p class="mt-0.5 text-lg font-bold text-slate-900">
            {latestSnapshot.total.toLocaleString("ja-JP")} 人
          </p>
          <p class="mt-0.5 text-[11px] text-slate-600">
            男 {latestSnapshot.male.toLocaleString("ja-JP")} / 女{" "}
            {latestSnapshot.female.toLocaleString("ja-JP")}
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5">
          <p class="text-[11px] font-medium text-slate-500">
            生産年齢人口（15〜64歳）
          </p>
          <p class="mt-0.5 text-lg font-bold text-slate-900">
            {latestMetrics.workingPct.toFixed(1)}%
          </p>
          <p class="mt-0.5 text-[11px] text-slate-600">
            {latestMetrics.workingCount.toLocaleString("ja-JP")} 人
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5">
          <p class="text-[11px] font-medium text-slate-500">
            高齢化率（65歳以上）
          </p>
          <p class="mt-0.5 text-lg font-bold text-slate-900">
            {latestMetrics.elderlyPct.toFixed(1)}%
          </p>
          <p class="mt-0.5 text-[11px] text-slate-600">
            {latestMetrics.elderlyCount.toLocaleString("ja-JP")} 人（75歳以上{" "}
            {latestMetrics.lateElderlyPct.toFixed(1)}%）
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3.5">
          <p class="text-[11px] font-medium text-slate-500">
            平均年齢 / 中央値
          </p>
          <p class="mt-0.5 text-lg font-bold text-slate-900">
            {latestMetrics.averageAge.toFixed(1)}歳 / {latestMetrics.medianAge}歳
          </p>
          <p class="mt-0.5 text-[11px] text-slate-600">
            最多年齢: {latestMetrics.peakAge.age}歳（
            {latestMetrics.peakAge.total.toLocaleString("ja-JP")}人）
          </p>
        </div>
      </div>

      <!-- Pyramid Legend & Inspector -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 text-xs">
        <div class="flex flex-wrap items-center gap-4">
          <span class="inline-flex items-center gap-1.5 font-medium text-slate-700">
            <span class="inline-block h-3 w-3 rounded-sm bg-[#244666]" />
            男性
          </span>
          <span class="inline-flex items-center gap-1.5 font-medium text-slate-700">
            <span class="inline-block h-3 w-3 rounded-sm bg-[#cf4f6b]" />
            女性
          </span>
          <span
            id="pyramid-compare-legend"
            class="inline-flex items-center gap-1.5 font-medium text-amber-800"
          >
            <span class="inline-block h-3 w-3 rounded-sm border-2 border-dashed border-[#d97706]" />
            <span id="pyramid-compare-note">比較枠: 2017年11月</span>
          </span>
        </div>
        <p class="text-[11px] text-slate-500">
          グラフ上の年代バーにカーソルを合わせるかクリックすると詳細確認・推移グラフ連動ができます
        </p>
      </div>

      <div
        id="band-inspector"
        class="mt-3 flex flex-wrap items-center justify-between gap-2 rounded-xl border border-alps-200/80 bg-alps-50/70 px-4 py-2.5 text-xs text-slate-800"
      >
        <span>
          年代を選択またはホバーすると、男女別の実数と構成比・比較差を表示します。
        </span>
      </div>

      <!-- Pyramid SVG -->
      <div class="mt-3 overflow-x-auto">
        <svg
          id="pyramid-svg"
          viewBox="0 0 820 430"
          role="img"
          aria-labelledby="pyramid-svg-title"
          class="mx-auto block h-auto w-full min-w-[340px] max-w-[860px] select-none"
        >
          <title id="pyramid-svg-title">松本市 年齢別男女別人口ピラミッド</title>
        </svg>
      </div>

      <!-- Collapsible Numeric Table -->
      <details class="mt-4 rounded-xl border border-slate-200 bg-slate-50/50 p-3.5">
        <summary class="cursor-pointer text-xs font-semibold text-alps-800 hover:text-alps-950">
          選択中時点・粒度の数値一覧テーブルを開く
        </summary>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[540px] border-collapse text-left text-xs">
            <thead>
              <tr class="border-b border-slate-200 text-slate-500">
                <th class="py-2 pr-3 font-semibold">年齢階級</th>
                <th class="px-3 py-2 text-right font-semibold">総数</th>
                <th class="px-3 py-2 text-right font-semibold">男性</th>
                <th class="px-3 py-2 text-right font-semibold">女性</th>
                <th class="px-3 py-2 text-right font-semibold">構成比</th>
                <th
                  id="pyramid-table-diff-header"
                  class="pl-3 py-2 text-right font-semibold"
                >
                  比較差
                </th>
              </tr>
            </thead>
            <tbody id="pyramid-table-body" class="divide-y divide-slate-100" />
          </table>
        </div>
      </details>
    </section>

    <!-- Section 2: Decade / Age-Group Trend Chart -->
    <section
      id="trend-section"
      aria-labelledby="trend-heading"
      class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="trend-heading" class="text-lg font-bold text-slate-900 sm:text-xl">
            2. 年代別の人口推移グラフ（2017年〜2026年）
          </h2>
