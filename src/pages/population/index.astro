  <script>
    import {
      type AgeBandRow,
      type AgeGranularity,
      aggregateBands,
      buildTrendSeries,
      type CompareMode,
      computeGlobalMaxBandSide,
      computeSnapshotMetrics,
      DECADE_TREND_GROUPS,
      findDecadeTrendGroupForBand,
      formatYmJa,
      resolveComparisonSnapshot,
      resolveSnapshotForYearMonth,
      THREE_TIER_TREND_GROUPS,
      type TrendCadence,
      type TrendCategoryMode,
      type TrendGroupSpec,
      type TrendPoint,
    } from "@/lib/population-analytics";
    import type {
      PopulationDataset,
      PopulationSnapshot,
    } from "@/lib/population-schema";

    const dataScript = document.getElementById("population-data");
    if (!dataScript?.textContent) {
      throw new Error("Missing embedded population data");
    }
    const dataset: PopulationDataset = JSON.parse(dataScript.textContent);
    const snapshots = dataset.snapshots;
    const snapshotIndexByYm = new Map<string, number>(
      snapshots.map((s, idx) => [s.ym, idx]),
    );

    const SVG_NS = "http://www.w3.org/2000/svg";

    function svgEl<K extends keyof SVGElementTagNameMap>(
      tag: K,
      attrs: Record<string, string | number>,
      text?: string,
    ): SVGElementTagNameMap[K] {
      const node = document.createElementNS(SVG_NS, tag);
      for (const [key, val] of Object.entries(attrs)) {
        node.setAttribute(key, String(val));
      }
      if (text !== undefined) {
        node.textContent = text;
      }
      return node;
    }

    function htmlEl<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className?: string,
      text?: string,
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function formatSignedInt(diff: number): string {
      const prefix = diff > 0 ? "+" : "";
      return `${prefix}${diff.toLocaleString("ja-JP")}人`;
    }

    function formatSignedPct(diff: number, suffix = "%"): string {
      const prefix = diff > 0 ? "+" : "";
      return `${prefix}${diff.toFixed(1)}${suffix}`;
    }

    function computeNiceMax(rawMax: number): number {
      if (rawMax <= 0) return 10;
      const magnitude = 10 ** Math.floor(Math.log10(rawMax));
      const norm = rawMax / magnitude;
      let step = 1;
      if (norm <= 1.2) step = 1.2;
      else if (norm <= 1.5) step = 1.5;
      else if (norm <= 2) step = 2;
      else if (norm <= 2.5) step = 2.5;
      else if (norm <= 3) step = 3;
      else if (norm <= 4) step = 4;
      else if (norm <= 5) step = 5;
      else if (norm <= 6) step = 6;
      else if (norm <= 8) step = 8;
      else step = 10;
      return Math.ceil(step * magnitude);
    }

    function computeNiceRange(minVal: number, maxVal: number, isPercent = false): {
      min: number;
      max: number;
      ticks: number[];
    } {
      if (minVal === maxVal) {
        const pad = isPercent ? 2 : Math.max(100, Math.round(maxVal * 0.1));
        const min = Math.max(0, minVal - pad);
        const max = maxVal + pad;
        const step = (max - min) / 4;
        return {
          min,
          max,
          ticks: [0, 1, 2, 3, 4].map((i) => min + step * i),
        };
      }

      const span = maxVal - minVal;
      const rawStep = span / 4;
      const mag = 10 ** Math.floor(Math.log10(rawStep));
      const norm = rawStep / mag;
      let niceStep = mag;
      if (norm <= 1) niceStep = 1 * mag;
      else if (norm <= 2) niceStep = 2 * mag;
      else if (norm <= 2.5) niceStep = 2.5 * mag;
      else if (norm <= 5) niceStep = 5 * mag;
      else niceStep = 10 * mag;

      const padding = span * 0.12;
      const min = Math.max(
        0,
        Math.floor((minVal - padding) / niceStep) * niceStep,
      );
      const max = Math.ceil((maxVal + padding) / niceStep) * niceStep;
      const tickCount = Math.max(2, Math.round((max - min) / niceStep));
      const ticks: number[] = [];
      for (let i = 0; i <= tickCount; i++) {
        ticks.push(min + i * niceStep);
      }
      return { min, max, ticks };
    }

    const globalMaxCache = new Map<AgeGranularity, number>();
    function getGlobalMax(granularity: AgeGranularity): number {
      const cached = globalMaxCache.get(granularity);
      if (cached !== undefined) return cached;
      const computed = computeGlobalMaxBandSide(snapshots, granularity);
      globalMaxCache.set(granularity, computed);
      return computed;
    }

    // Application state
    let currentIndex = snapshots.length - 1;
    let granularity: AgeGranularity = "decade";
    let compareMode: CompareMode = "start_2017";
    let axisMode: "fixed" | "auto" = "fixed";
    let inspectedBandId: string | null = null;

    let trendMode: TrendCategoryMode = "decade";
    let selectedTrendGroupId = "all";
    let trendCadence: TrendCadence = "annual_same_month";
    let trendSeriesKind: "gender" | "total" | "share" = "gender";
    let hoveredTrendYm: string | null = null;

    let playMode: "annual" | "monthly" = "annual";
    let playTimerId: number | null = null;

    // DOM refs
    const pyramidCurrentLabel = document.getElementById("pyramid-current-label");
    const pyramidCompareLegend = document.getElementById(
      "pyramid-compare-legend",
    );
    const pyramidCompareNote = document.getElementById("pyramid-compare-note");
    const yearMonthClampNote = document.getElementById("year-month-clamp-note");
    const summaryCardsEl = document.getElementById("summary-cards");
    const bandInspectorEl = document.getElementById("band-inspector");
    const pyramidSvgEl = document.getElementById(
      "pyramid-svg",
    ) as SVGSVGElement | null;
    const pyramidTableBody = document.getElementById("pyramid-table-body");
    const pyramidTableDiffHeader = document.getElementById(
      "pyramid-table-diff-header",
    );
    const monthSelect = document.getElementById(
      "month-select",
    ) as HTMLSelectElement | null;
    const timelineSlider = document.getElementById(
      "timeline-slider",
    ) as HTMLInputElement | null;
    const playToggleBtn = document.getElementById(
      "play-toggle-btn",
    ) as HTMLButtonElement | null;

    const trendActiveLabel = document.getElementById("trend-active-label");
    const trendGroupButtonsEl = document.getElementById("trend-group-buttons");
    const trendSummaryCardsEl = document.getElementById("trend-summary-cards");
    const trendLegendEl = document.getElementById("trend-legend");
    const trendInspectorEl = document.getElementById("trend-inspector");
    const trendSvgEl = document.getElementById(
      "trend-svg",
    ) as SVGSVGElement | null;

    const compositionMonthLabel = document.getElementById(
      "composition-month-label",
    );
    const compositionRowsEl = document.getElementById("composition-rows");

    const granularityButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-granularity-btn]"),
    );
    const compareButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-compare-btn]"),
    );
    const axisButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-axis-btn]"),
    );
    const yearButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-year-btn]"),
    );
    const playModeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-play-mode-btn]"),
    );
    const trendModeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-trend-mode-btn]"),
    );
    const cadenceButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-cadence-btn]"),
    );
    const seriesButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-series-btn]"),
    );

    function setButtonGroupState(
      buttons: HTMLButtonElement[],
      activeAttr: string,
      activeValue: string,
      variant: "rect" | "pill" | "compact",
    ): void {
      for (const btn of buttons) {
        const isActive = btn.getAttribute(activeAttr) === activeValue;
        btn.setAttribute("aria-pressed", isActive ? "true" : "false");
        if (variant === "rect") {
          btn.className = isActive
            ? "rounded-xl bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
            : "rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900";
        } else if (variant === "compact") {
          btn.className = isActive
            ? "rounded-lg bg-alps-900 px-2.5 py-1 text-xs font-semibold text-white transition"
            : "rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900";
        } else {
          btn.className = isActive
            ? "rounded-full bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
            : "rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900";
        }
      }
    }

    function stopPlayback(): void {
      if (playTimerId !== null) {
        window.clearInterval(playTimerId);
        playTimerId = null;
      }
      if (playToggleBtn) {
        playToggleBtn.setAttribute("aria-pressed", "false");
        playToggleBtn.textContent = "▶ 10年変化を再生";
      }
    }

    function getCurrentSnapshot(): PopulationSnapshot {
      const snap = snapshots[currentIndex] ?? snapshots[snapshots.length - 1];
      if (!snap) {
        throw new Error("Empty snapshots");
      }
      return snap;
    }

    function selectYearMonth(year: number, month: number, stopAuto = true): void {
      if (stopAuto) stopPlayback();
      const resolved = resolveSnapshotForYearMonth(snapshots, year, month);
      const idx = snapshotIndexByYm.get(resolved.ym);
      if (idx !== undefined) {
        currentIndex = idx;
      }
      if (yearMonthClampNote) {
        if (resolved.year !== year || resolved.month !== month) {
          yearMonthClampNote.textContent = `※ ${year}年${month}月は未収録のため、同年の最新収録月（${resolved.year}年${resolved.month}月）を表示しています。`;
          yearMonthClampNote.classList.remove("hidden");
        } else {
          yearMonthClampNote.classList.add("hidden");
        }
      }
      renderAll();
    }

    function renderSummaryCards(
      current: PopulationSnapshot,
      compareSnap: PopulationSnapshot | null,
    ): void {
      if (!summaryCardsEl) return;
      const curMetrics = computeSnapshotMetrics(current);
      const cmpMetrics = compareSnap
        ? computeSnapshotMetrics(compareSnap)
        : null;

      summaryCardsEl.replaceChildren();

      const totalDiff = compareSnap ? current.total - compareSnap.total : null;
      const workingDiff = cmpMetrics
        ? curMetrics.workingCount - cmpMetrics.workingCount
        : null;
      const elderlyPctDiff = cmpMetrics
        ? Math.round((curMetrics.elderlyPct - cmpMetrics.elderlyPct) * 10) / 10
        : null;
      const avgAgeDiff = cmpMetrics
        ? Math.round((curMetrics.averageAge - cmpMetrics.averageAge) * 10) / 10
        : null;

      const cards: Array<{ title: string; value: string; sub: string }> = [
        {
          title: "総人口",
          value: `${current.total.toLocaleString("ja-JP")} 人`,
          sub:
            totalDiff !== null && compareSnap
              ? `男 ${current.male.toLocaleString("ja-JP")} / 女 ${current.female.toLocaleString("ja-JP")}（${compareSnap.year}年比 ${formatSignedInt(totalDiff)}）`
              : `男 ${current.male.toLocaleString("ja-JP")} / 女 ${current.female.toLocaleString("ja-JP")}`,
        },
        {
          title: "生産年齢人口（15〜64歳）",
          value: `${curMetrics.workingPct.toFixed(1)}%`,
          sub:
            workingDiff !== null && compareSnap
              ? `${curMetrics.workingCount.toLocaleString("ja-JP")} 人（${compareSnap.year}年比 ${formatSignedInt(workingDiff)}）`
              : `${curMetrics.workingCount.toLocaleString("ja-JP")} 人（年少 ${curMetrics.youthPct.toFixed(1)}%）`,
        },
        {
          title: "高齢化率（65歳以上）",
          value: `${curMetrics.elderlyPct.toFixed(1)}%`,
          sub:
            elderlyPctDiff !== null && compareSnap
              ? `${curMetrics.elderlyCount.toLocaleString("ja-JP")} 人（${compareSnap.year}年比 ${formatSignedPct(elderlyPctDiff, "pt")}）`
              : `${curMetrics.elderlyCount.toLocaleString("ja-JP")} 人（75歳〜 ${curMetrics.lateElderlyPct.toFixed(1)}%）`,
        },
        {
          title: "平均年齢 / 中央値",
          value: `${curMetrics.averageAge.toFixed(1)}歳 / ${curMetrics.medianAge}歳`,
          sub:
            avgAgeDiff !== null && compareSnap
              ? `最多年齢: ${curMetrics.peakAge.age}歳（平均 ${formatSignedPct(avgAgeDiff, "歳")}）`
              : `最多年齢: ${curMetrics.peakAge.age}歳（${curMetrics.peakAge.total.toLocaleString("ja-JP")}人）`,
        },
      ];

      for (const card of cards) {
        const box = htmlEl(
          "div",
          "rounded-xl border border-slate-200 bg-slate-50/70 p-3.5",
        );
        box.append(
          htmlEl("p", "text-[11px] font-medium text-slate-500", card.title),
          htmlEl("p", "mt-0.5 text-lg font-bold text-slate-900", card.value),
          htmlEl("p", "mt-0.5 text-[11px] text-slate-600", card.sub),
        );
        summaryCardsEl.appendChild(box);
      }
    }

    function renderBandInspector(
      band: AgeBandRow | null,
      compareBand: AgeBandRow | null,
      compareSnap: PopulationSnapshot | null,
    ): void {
      if (!bandInspectorEl) return;
      bandInspectorEl.replaceChildren();

      if (!band) {
        const msg = htmlEl(
          "span",
          "text-slate-600",
          "年代バーにカーソルを合わせるかクリックすると、男女別の人数・構成比・比較差を確認し、下の推移グラフを連動できます。",
        );
        bandInspectorEl.appendChild(msg);
        return;
      }

      const left = htmlEl("div", "flex flex-wrap items-center gap-x-4 gap-y-1");
      left.append(
        htmlEl("span", "font-bold text-alps-950", band.label),
        htmlEl(
          "span",
          "font-semibold text-slate-800",
          `計 ${band.total.toLocaleString("ja-JP")}人（${band.sharePct.toFixed(1)}%）`,
        ),
        htmlEl(
          "span",
          "text-[#244666] font-medium",
          `男 ${band.male.toLocaleString("ja-JP")}人（${band.maleSharePct.toFixed(1)}%）`,
        ),
        htmlEl(
          "span",
          "text-[#b23b56] font-medium",
          `女 ${band.female.toLocaleString("ja-JP")}人（${(100 - band.maleSharePct).toFixed(1)}%）`,
        ),
      );

      if (compareBand && compareSnap) {
        const diff = band.total - compareBand.total;
        left.append(
          htmlEl(
            "span",
            `font-semibold ${diff >= 0 ? "text-emerald-700" : "text-rose-700"}`,
            `${compareSnap.year}年比 ${formatSignedInt(diff)}`,
          ),
        );
      }

      const targetDecadeId = findDecadeTrendGroupForBand(band);
      const targetSpec = DECADE_TREND_GROUPS.find((g) => g.id === targetDecadeId);

      const actionBtn = htmlEl(
        "button",
        "rounded-lg bg-white px-2.5 py-1 text-[11px] font-semibold text-alps-800 ring-1 ring-alps-300 transition hover:bg-alps-100",
        `${targetSpec?.label ?? targetDecadeId} の推移グラフへ ↓`,
      );
      actionBtn.type = "button";
      actionBtn.addEventListener("click", () => {
        trendMode = "decade";
        selectedTrendGroupId = targetDecadeId;
        renderTrendSection();
        document
          .getElementById("trend-section")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      bandInspectorEl.append(left, actionBtn);
    }

    function renderPyramid(
      current: PopulationSnapshot,
      compareSnap: PopulationSnapshot | null,
    ): void {
      if (!pyramidSvgEl) return;

      const bands = aggregateBands(current, granularity);
      const compareBands = compareSnap
        ? aggregateBands(compareSnap, granularity)
        : null;
      const compareBandMap = compareBands
        ? new Map<string, AgeBandRow>(compareBands.map((b) => [b.id, b]))
        : null;

      if (inspectedBandId && !bands.some((b) => b.id === inspectedBandId)) {
        inspectedBandId = null;
      }

      let rawMaxSide = 0;
      if (axisMode === "fixed") {
        rawMaxSide = getGlobalMax(granularity);
      } else {
        for (const b of bands) {
          if (b.male > rawMaxSide) rawMaxSide = b.male;
          if (b.female > rawMaxSide) rawMaxSide = b.female;
        }
        if (compareBands) {
          for (const b of compareBands) {
            if (b.male > rawMaxSide) rawMaxSide = b.male;
            if (b.female > rawMaxSide) rawMaxSide = b.female;
          }
        }
      }
      const maxSide = computeNiceMax(rawMaxSide);

      const rowHeight =
        granularity === "decade" ? 31 : granularity === "five_year" ? 23 : 5.2;
      const topPad = 34;
      const bottomPad = 42;
      const plotHeight = bands.length * rowHeight;
      const viewHeight = Math.ceil(topPad + plotHeight + bottomPad);

      const width = 820;
      const centerLeft = 365;
      const centerRight = 455;
      const outerMargin = 68;
      const sideMaxWidth = centerLeft - outerMargin; // 297px

      pyramidSvgEl.setAttribute("viewBox", `0 0 ${width} ${viewHeight}`);
      pyramidSvgEl.replaceChildren();

      // Column headers
      pyramidSvgEl.append(
        svgEl(
          "text",
          {
            x: centerLeft - 8,
            y: 19,
            "text-anchor": "end",
            "font-size": 12,
            "font-weight": 700,
            fill: "#244666",
          },
          "← 男性（人）",
        ),
        svgEl(
          "text",
          {
            x: (centerLeft + centerRight) / 2,
            y: 19,
            "text-anchor": "middle",
            "font-size": 11,
            "font-weight": 700,
            fill: "#475569",
          },
          "年齢階級",
        ),
        svgEl(
          "text",
          {
            x: centerRight + 8,
            y: 19,
            "text-anchor": "start",
            "font-size": 12,
            "font-weight": 700,
            fill: "#b23b56",
          },
          "女性（人） →",
        ),
      );

      // Vertical X gridlines & axis labels
      const tickFractions = [0, 0.5, 1];
      for (const frac of tickFractions) {
        const tickVal = Math.round(maxSide * frac);
        const offset = sideMaxWidth * frac;
        const leftX = centerLeft - offset;
        const rightX = centerRight + offset;

        for (const gx of [leftX, rightX]) {
          pyramidSvgEl.appendChild(
            svgEl("line", {
              x1: gx,
              y1: topPad,
              x2: gx,
              y2: topPad + plotHeight,
              stroke: frac === 0 ? "#94a3b8" : "#e2e8f0",
              "stroke-width": frac === 0 ? 1.2 : 1,
            }),
          );
        }

        const labelY = topPad + plotHeight + 18;
        pyramidSvgEl.append(
          svgEl(
            "text",
            {
              x: leftX,
              y: labelY,
              "text-anchor": "middle",
              "font-size": 10.5,
              fill: "#64748b",
            },
            tickVal.toLocaleString("ja-JP"),
          ),
          svgEl(
            "text",
            {
              x: rightX,
              y: labelY,
              "text-anchor": "middle",
              "font-size": 10.5,
              fill: "#64748b",
            },
            tickVal.toLocaleString("ja-JP"),
          ),
        );
      }

      // Draw rows from oldest at top (index bands.length - 1) to youngest at bottom (index 0)
      const totalRows = bands.length;
      const singleCompareMalePts: string[] = [];
      const singleCompareFemalePts: string[] = [];

      for (let i = 0; i < totalRows; i++) {
        const band = bands[totalRows - 1 - i];
        if (!band) continue;
        const cmpBand = compareBandMap?.get(band.id) ?? null;

        const rowTop = topPad + i * rowHeight;
        const barPad = granularity === "single" ? 0.4 : 3.5;
        const barH = Math.max(2, rowHeight - barPad * 2);
        const barY = rowTop + barPad;

        const maleW = (band.male / maxSide) * sideMaxWidth;
        const femaleW = (band.female / maxSide) * sideMaxWidth;
        const maleX = centerLeft - maleW;
        const femaleX = centerRight;
        const isSelected = inspectedBandId === band.id;

        const rowGroup = svgEl("g", {
          class: "cursor-pointer outline-none",
          tabindex: "0",
          role: "button",
          "aria-label": `${band.label} 総数 ${band.total.toLocaleString("ja-JP")}人 男性 ${band.male.toLocaleString("ja-JP")}人 女性 ${band.female.toLocaleString("ja-JP")}人`,
        });

        const hoverBg = svgEl("rect", {
          x: outerMargin - 20,
          y: rowTop,
          width: width - (outerMargin - 20) * 2,
          height: rowHeight,
          rx: granularity === "single" ? 0 : 4,
          fill: isSelected ? "rgba(59, 107, 148, 0.12)" : "transparent",
        });
        rowGroup.appendChild(hoverBg);

        if (granularity === "single" && band.minAge % 10 === 0) {
          pyramidSvgEl.appendChild(
            svgEl("line", {
              x1: outerMargin,
              y1: rowTop + rowHeight,
              x2: width - outerMargin,
              y2: rowTop + rowHeight,
              stroke: "#e2e8f0",
              "stroke-width": 0.8,
              "stroke-dasharray": "2 2",
            }),
          );
        }

        // Male & Female bars
        rowGroup.append(
          svgEl("rect", {
            x: maleX,
            y: barY,
            width: Math.max(0.5, maleW),
            height: barH,
            rx: granularity === "single" ? 0.5 : 3,
            fill: isSelected ? "#1b344d" : "#244666",
          }),
          svgEl("rect", {
            x: femaleX,
            y: barY,
            width: Math.max(0.5, femaleW),
            height: barH,
            rx: granularity === "single" ? 0.5 : 3,
            fill: isSelected ? "#b23b56" : "#cf4f6b",
          }),
        );

        // Comparison overlay
        if (cmpBand) {
          const cmpMaleW = (cmpBand.male / maxSide) * sideMaxWidth;
          const cmpFemaleW = (cmpBand.female / maxSide) * sideMaxWidth;

          if (granularity === "single") {
            const cy = rowTop + rowHeight / 2;
            singleCompareMalePts.push(`${(centerLeft - cmpMaleW).toFixed(1)},${cy.toFixed(1)}`);
            singleCompareFemalePts.push(`${(centerRight + cmpFemaleW).toFixed(1)},${cy.toFixed(1)}`);
          } else {
            rowGroup.append(
              svgEl("rect", {
                x: centerLeft - cmpMaleW,
                y: barY,
                width: Math.max(0.5, cmpMaleW),
                height: barH,
                rx: 3,
                fill: "none",
                stroke: "#d97706",
                "stroke-width": 1.6,
                "stroke-dasharray": "3 2",
              }),
              svgEl("rect", {
                x: centerRight,
                y: barY,
                width: Math.max(0.5, cmpFemaleW),
                height: barH,
                rx: 3,
                fill: "none",
                stroke: "#d97706",
                "stroke-width": 1.6,
                "stroke-dasharray": "3 2",
              }),
            );
          }
        }

        // Center age label
        const showCenterLabel =
          granularity !== "single" || band.minAge % 10 === 0;
        if (showCenterLabel) {
          rowGroup.appendChild(
            svgEl(
              "text",
              {
                x: (centerLeft + centerRight) / 2,
                y: rowTop + rowHeight / 2 + 3.5,
                "text-anchor": "middle",
                "font-size": granularity === "decade" ? 11.5 : 10,
                "font-weight": isSelected ? 700 : 600,
                fill: isSelected ? "#0c1724" : "#334155",
              },
              band.shortLabel,
            ),
          );
        }

        // Outer value labels for decade and five_year
        if (granularity !== "single") {
          const valFontSize = granularity === "decade" ? 10.5 : 9.5;
          const cmpMaleMax = cmpBand
            ? (cmpBand.male / maxSide) * sideMaxWidth
            : 0;
          const cmpFemaleMax = cmpBand
            ? (cmpBand.female / maxSide) * sideMaxWidth
            : 0;
          const leftTip = centerLeft - Math.max(maleW, cmpMaleMax);
          const rightTip = centerRight + Math.max(femaleW, cmpFemaleMax);

          rowGroup.append(
            svgEl(
              "text",
              {
                x: leftTip - 5,
                y: rowTop + rowHeight / 2 + 3.5,
                "text-anchor": "end",
                "font-size": valFontSize,
                fill: "#334155",
              },
              band.male.toLocaleString("ja-JP"),
            ),
            svgEl(
              "text",
              {
                x: rightTip + 5,
                y: rowTop + rowHeight / 2 + 3.5,
                "text-anchor": "start",
                "font-size": valFontSize,
                fill: "#334155",
              },
              band.female.toLocaleString("ja-JP"),
            ),
          );
        }

        const activatePreview = () => {
          renderBandInspector(band, cmpBand, compareSnap);
        };
        rowGroup.addEventListener("mouseenter", activatePreview);
        rowGroup.addEventListener("focus", activatePreview);
        rowGroup.addEventListener("click", () => {
          inspectedBandId = band.id;
          trendMode = "decade";
          selectedTrendGroupId = findDecadeTrendGroupForBand(band);
          renderBandInspector(band, cmpBand, compareSnap);
          renderPyramid(current, compareSnap);
          renderTrendSection();
        });

        pyramidSvgEl.appendChild(rowGroup);
      }

      if (granularity === "single" && compareSnap) {
        if (singleCompareMalePts.length > 1) {
          pyramidSvgEl.appendChild(
            svgEl("polyline", {
              points: singleCompareMalePts.join(" "),
              fill: "none",
              stroke: "#d97706",
              "stroke-width": 1.8,
              "stroke-dasharray": "4 2",
              "pointer-events": "none",
            }),
          );
        }
        if (singleCompareFemalePts.length > 1) {
          pyramidSvgEl.appendChild(
            svgEl("polyline", {
              points: singleCompareFemalePts.join(" "),
              fill: "none",
              stroke: "#d97706",
              "stroke-width": 1.8,
              "stroke-dasharray": "4 2",
              "pointer-events": "none",
            }),
          );
        }
      }

      const activeBand =
        (inspectedBandId
          ? bands.find((b) => b.id === inspectedBandId)
          : bands.find((b) => b.minAge <= 30 && b.maxAge >= 30)) ??
        bands[0] ??
        null;
      const activeCmpBand = activeBand
        ? (compareBandMap?.get(activeBand.id) ?? null)
        : null;
      renderBandInspector(activeBand, activeCmpBand, compareSnap);
    }

    function renderPyramidTable(
      current: PopulationSnapshot,
      compareSnap: PopulationSnapshot | null,
    ): void {
      if (!pyramidTableBody) return;
      const bands = aggregateBands(current, granularity);
      const cmpBands = compareSnap
        ? aggregateBands(compareSnap, granularity)
        : null;
      const cmpMap = cmpBands
        ? new Map<string, AgeBandRow>(cmpBands.map((b) => [b.id, b]))
        : null;

      if (pyramidTableDiffHeader) {
        pyramidTableDiffHeader.textContent = compareSnap
          ? `${compareSnap.year}年${compareSnap.month}月比`
          : "比較差";
      }

      pyramidTableBody.replaceChildren();
      for (const band of bands) {
        const cmpBand = cmpMap?.get(band.id) ?? null;
        const tr = htmlEl("tr", "hover:bg-slate-100/70");
        const diffCell = htmlEl("td", "pl-3 py-1.5 text-right font-mono");
        if (cmpBand) {
          const diff = band.total - cmpBand.total;
          diffCell.textContent = formatSignedInt(diff);
          diffCell.className +=
            diff >= 0 ? " text-emerald-700" : " text-rose-700";
        } else {
          diffCell.textContent = "—";
          diffCell.className += " text-slate-400";
        }

        tr.append(
          htmlEl("td", "py-1.5 pr-3 font-medium text-slate-800", band.label),
          htmlEl(
            "td",
            "px-3 py-1.5 text-right font-mono font-semibold text-slate-900",
            band.total.toLocaleString("ja-JP"),
          ),
          htmlEl(
            "td",
            "px-3 py-1.5 text-right font-mono text-[#244666]",
            band.male.toLocaleString("ja-JP"),
          ),
          htmlEl(
            "td",
            "px-3 py-1.5 text-right font-mono text-[#b23b56]",
            band.female.toLocaleString("ja-JP"),
          ),
          htmlEl(
            "td",
            "px-3 py-1.5 text-right font-mono text-slate-600",
            `${band.sharePct.toFixed(1)}%`,
          ),
          diffCell,
        );
        pyramidTableBody.appendChild(tr);
      }
    }

    function getActiveTrendSpecs(): readonly TrendGroupSpec[] {
      return trendMode === "decade"
        ? DECADE_TREND_GROUPS
        : THREE_TIER_TREND_GROUPS;
    }

    function getActiveTrendSpec(): TrendGroupSpec {
      const specs = getActiveTrendSpecs();
      return (
        specs.find((g) => g.id === selectedTrendGroupId) ??
        specs[0] ?? {
          id: "all",
          label: "全年齢",
          shortLabel: "全年齢",
          minAge: 0,
          maxAge: 109,
          description: "",
        }
      );
    }

    function renderTrendInspector(
      point: TrendPoint | null,
      spec: TrendGroupSpec,
    ): void {
      if (!trendInspectorEl) return;
      trendInspectorEl.replaceChildren();
      if (!point) {
        trendInspectorEl.textContent = "データポイントがありません。";
        return;
      }

      const wrap = htmlEl("div", "flex flex-wrap items-center gap-x-4 gap-y-1");
      wrap.append(
        htmlEl(
          "span",
          "font-bold text-alps-950",
          `${formatYmJa(point.ym, false)}（${spec.label}）`,
        ),
        htmlEl(
          "span",
          "font-semibold text-slate-900",
          `総数 ${point.total.toLocaleString("ja-JP")}人`,
        ),
        htmlEl(
          "span",
          "font-medium text-[#244666]",
          `男 ${point.male.toLocaleString("ja-JP")}人`,
        ),
        htmlEl(
          "span",
          "font-medium text-[#b23b56]",
          `女 ${point.female.toLocaleString("ja-JP")}人`,
        ),
        htmlEl(
          "span",
          "text-teal-800 font-medium",
          `全人口比 ${point.sharePct.toFixed(1)}%`,
        ),
        htmlEl(
          "span",
          `font-medium ${point.diffFromStart >= 0 ? "text-emerald-700" : "text-rose-700"}`,
          `開始比 ${formatSignedInt(point.diffFromStart)}（${formatSignedPct(point.pctFromStart)}）`,
        ),
      );
      trendInspectorEl.appendChild(wrap);
    }

    function renderTrendSection(): void {
      const current = getCurrentSnapshot();
      const specs = getActiveTrendSpecs();
      if (!specs.some((s) => s.id === selectedTrendGroupId)) {
        selectedTrendGroupId = specs[0]?.id ?? "all";
      }
      const spec = getActiveTrendSpec();

      setButtonGroupState(
        trendModeButtons,
        "data-trend-mode-btn",
        trendMode,
        "rect",
      );
      setButtonGroupState(
        cadenceButtons,
        "data-cadence-btn",
        trendCadence,
        "pill",
      );
      setButtonGroupState(
        seriesButtons,
        "data-series-btn",
        trendSeriesKind,
        "pill",
      );

      if (trendActiveLabel) {
        trendActiveLabel.textContent = `${spec.label}（${spec.minAge}〜${spec.maxAge}歳）`;
      }

      if (trendGroupButtonsEl) {
        trendGroupButtonsEl.replaceChildren();
        for (const item of specs) {
          const isActive = item.id === spec.id;
          const btn = htmlEl(
            "button",
            isActive
              ? "rounded-xl bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
              : "rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900",
            item.shortLabel,
          );
          btn.type = "button";
          btn.setAttribute("aria-pressed", isActive ? "true" : "false");
          btn.addEventListener("click", () => {
            selectedTrendGroupId = item.id;
            hoveredTrendYm = null;
            renderTrendSection();
          });
          trendGroupButtonsEl.appendChild(btn);
        }
      }

      const series = buildTrendSeries(
        snapshots,
        spec.minAge,
        spec.maxAge,
        trendCadence,
        current.month,
      );

      if (trendSummaryCardsEl && series.length > 0) {
        trendSummaryCardsEl.replaceChildren();
        const activePt =
          series.find((pt) => pt.ym === current.ym) ??
          series[series.length - 1];
        const firstPt = series[0];
        const lastPt = series[series.length - 1];

        let maxPt = series[0];
        let minPt = series[0];
        for (const pt of series) {
          if (maxPt && pt.total > maxPt.total) maxPt = pt;
          if (minPt && pt.total < minPt.total) minPt = pt;
        }

        if (activePt && firstPt && lastPt && maxPt && minPt) {
          const maleShare =
            activePt.total > 0
              ? ((activePt.male / activePt.total) * 100).toFixed(1)
              : "0.0";
          const femaleShare =
            activePt.total > 0
              ? ((activePt.female / activePt.total) * 100).toFixed(1)
              : "0.0";

          const cards: Array<{ title: string; value: string; sub: string }> = [
            {
              title: `${formatYmJa(activePt.ym, false)}の人口（${spec.label}）`,
              value: `${activePt.total.toLocaleString("ja-JP")} 人`,
              sub: `全人口比 ${activePt.sharePct.toFixed(1)}% / 男 ${maleShare}%・女 ${femaleShare}%`,
            },
            {
              title: `${formatYmJa(firstPt.ym, false)} → ${formatYmJa(lastPt.ym, false)}の変化`,
              value: `${formatSignedInt(lastPt.diffFromStart)}`,
              sub: `変化率 ${formatSignedPct(lastPt.pctFromStart)}（${firstPt.total.toLocaleString("ja-JP")} → ${lastPt.total.toLocaleString("ja-JP")}人）`,
            },
            {
              title: "表示期間内の最多 / 最少",
              value: `${maxPt.total.toLocaleString("ja-JP")} / ${minPt.total.toLocaleString("ja-JP")} 人`,
              sub: `最多 ${formatYmJa(maxPt.ym, false)} ・ 最少 ${formatYmJa(minPt.ym, false)}`,
            },
          ];

          for (const card of cards) {
            const box = htmlEl(
              "div",
              "rounded-xl border border-slate-200 bg-slate-50/70 p-3.5",
            );
            box.append(
              htmlEl("p", "text-[11px] font-medium text-slate-500", card.title),
              htmlEl(
                "p",
                "mt-0.5 text-base font-bold text-slate-900 sm:text-lg",
                card.value,
              ),
              htmlEl("p", "mt-0.5 text-[11px] text-slate-600", card.sub),
            );
            trendSummaryCardsEl.appendChild(box);
          }
        }
      }

      if (trendLegendEl) {
        trendLegendEl.replaceChildren();
        const addLegendItem = (color: string, label: string) => {
          const item = htmlEl(
            "span",
            "inline-flex items-center gap-1.5 font-medium text-slate-700",
          );
          const swatch = htmlEl("span", "inline-block h-2.5 w-4 rounded-sm");
          swatch.style.backgroundColor = color;
          item.append(swatch, document.createTextNode(label));
          trendLegendEl.appendChild(item);
        };
        if (trendSeriesKind === "gender") {
          addLegendItem("#244666", "男性（人）");
          addLegendItem("#cf4f6b", "女性（人）");
        } else if (trendSeriesKind === "total") {
          addLegendItem("#244666", `${spec.label} 総数（人）`);
        } else {
          addLegendItem("#0f766e", `${spec.label} 全人口比（%）`);
        }
      }

      if (!trendSvgEl || series.length === 0) return;
      trendSvgEl.replaceChildren();

      const width = 820;
      const height = 330;
      const padLeft = 72;
      const padRight = 24;
      const padTop = 24;
      const padBottom = 46;
      const plotW = width - padLeft - padRight;
      const plotH = height - padTop - padBottom;

      const values: number[] = [];
      for (const pt of series) {
        if (trendSeriesKind === "gender") {
          values.push(pt.male, pt.female);
        } else if (trendSeriesKind === "total") {
          values.push(pt.total);
        } else {
          values.push(pt.sharePct);
        }
      }

      const rawMin = Math.min(...values);
      const rawMax = Math.max(...values);
      const yRange = computeNiceRange(
        rawMin,
        rawMax,
        trendSeriesKind === "share",
      );
      const ySpan = Math.max(0.1, yRange.max - yRange.min);

      const xAt = (idx: number) =>
        series.length <= 1
          ? padLeft + plotW / 2
          : padLeft + (idx / (series.length - 1)) * plotW;
      const yAt = (val: number) =>
        padTop + ((yRange.max - val) / ySpan) * plotH;

      // Y gridlines & labels
      for (const tick of yRange.ticks) {
        const y = yAt(tick);
        trendSvgEl.append(
          svgEl("line", {
            x1: padLeft,
            y1: y,
            x2: width - padRight,
            y2: y,
            stroke: "#e2e8f0",
            "stroke-width": 1,
          }),
          svgEl(
            "text",
            {
              x: padLeft - 8,
              y: y + 3.5,
              "text-anchor": "end",
              "font-size": 10.5,
              fill: "#64748b",
            },
            trendSeriesKind === "share"
              ? `${tick.toFixed(1)}%`
              : Math.round(tick).toLocaleString("ja-JP"),
          ),
        );
      }

      // X axis labels
      for (let i = 0; i < series.length; i++) {
        const pt = series[i];
        if (!pt) continue;
        const showTick =
          trendCadence === "annual_same_month" || pt.month === 1;
        if (!showTick) continue;
        const x = xAt(i);
        trendSvgEl.append(
          svgEl("line", {
            x1: x,
            y1: padTop,
            x2: x,
            y2: padTop + plotH,
            stroke: "#f1f5f9",
            "stroke-width": 1,
          }),
          svgEl(
            "text",
            {
              x,
              y: padTop + plotH + 18,
              "text-anchor": "middle",
              "font-size": 10.5,
              fill: pt.ym === current.ym ? "#0c1724" : "#64748b",
              "font-weight": pt.ym === current.ym ? 700 : 400,
            },
            trendCadence === "annual_same_month"
              ? `${pt.year}年`
              : String(pt.year),
          ),
        );
      }

      // Vertical marker for current pyramid snapshot
      const activeIdx = series.findIndex((pt) => pt.ym === current.ym);
      if (activeIdx !== -1) {
        const ax = xAt(activeIdx);
        trendSvgEl.appendChild(
          svgEl("line", {
            x1: ax,
            y1: padTop,
            x2: ax,
            y2: padTop + plotH,
            stroke: "#d97706",
            "stroke-width": 1.6,
            "stroke-dasharray": "4 3",
          }),
        );
      }

      const drawPolyline = (
        coords: Array<{ x: number; y: number; pt: TrendPoint }>,
        stroke: string,
        withArea: boolean,
      ) => {
        if (coords.length === 0) return;
        if (withArea && coords.length > 1) {
          const first = coords[0];
          const last = coords[coords.length - 1];
          if (first && last) {
            const areaD = [
              `M ${first.x.toFixed(1)} ${(padTop + plotH).toFixed(1)}`,
              ...coords.map(
                (c) => `L ${c.x.toFixed(1)} ${c.y.toFixed(1)}`,
              ),
              `L ${last.x.toFixed(1)} ${(padTop + plotH).toFixed(1)}`,
              "Z",
            ].join(" ");
            trendSvgEl.appendChild(
              svgEl("path", {
                d: areaD,
                fill:
                  trendSeriesKind === "share"
                    ? "rgba(15, 118, 110, 0.12)"
                    : "rgba(36, 70, 102, 0.12)",
              }),
            );
          }
        }

        const pointsAttr = coords
          .map((c) => `${c.x.toFixed(1)},${c.y.toFixed(1)}`)
          .join(" ");
        trendSvgEl.appendChild(
          svgEl("polyline", {
            points: pointsAttr,
            fill: "none",
            stroke,
            "stroke-width": 2.4,
            "stroke-linejoin": "round",
            "stroke-linecap": "round",
          }),
        );

        const showDots = trendCadence === "annual_same_month";
        for (const c of coords) {
          const isPinned =
            c.pt.ym === (hoveredTrendYm ?? current.ym);
          if (!showDots && !isPinned) continue;
          trendSvgEl.appendChild(
            svgEl("circle", {
              cx: c.x,
              cy: c.y,
              r: isPinned ? 5 : 3.5,
              fill: isPinned ? "#ffffff" : stroke,
              stroke,
              "stroke-width": isPinned ? 2.5 : 1.5,
            }),
          );
        }
      };

      if (trendSeriesKind === "gender") {
        drawPolyline(
          series.map((pt, i) => ({ x: xAt(i), y: yAt(pt.male), pt })),
          "#244666",
          false,
        );
        drawPolyline(
          series.map((pt, i) => ({ x: xAt(i), y: yAt(pt.female), pt })),
          "#cf4f6b",
          false,
        );
      } else if (trendSeriesKind === "total") {
        drawPolyline(
          series.map((pt, i) => ({ x: xAt(i), y: yAt(pt.total), pt })),
          "#244666",
          true,
        );
      } else {
        drawPolyline(
          series.map((pt, i) => ({ x: xAt(i), y: yAt(pt.sharePct), pt })),
          "#0f766e",
          true,
        );
      }

      // Interactive vertical hit columns
      const hitSliceW = plotW / Math.max(1, series.length);
      for (let i = 0; i < series.length; i++) {
        const pt = series[i];
        if (!pt) continue;
        const cx = xAt(i);
        const hitRect = svgEl("rect", {
          x: Math.max(padLeft, cx - hitSliceW / 2),
          y: padTop,
          width: hitSliceW,
          height: plotH,
          fill: "transparent",
          class: "cursor-pointer",
        });

        hitRect.addEventListener("mouseenter", () => {
          hoveredTrendYm = pt.ym;
          renderTrendInspector(pt, spec);
        });
        hitRect.addEventListener("click", () => {
          stopPlayback();
          const idx = snapshotIndexByYm.get(pt.ym);
          if (idx !== undefined) {
            currentIndex = idx;
            hoveredTrendYm = pt.ym;
            renderAll();
          }
        });
        trendSvgEl.appendChild(hitRect);
      }

      const defaultPt =
        (hoveredTrendYm
          ? series.find((pt) => pt.ym === hoveredTrendYm)
          : null) ??
        series.find((pt) => pt.ym === current.ym) ??
        series[series.length - 1] ??
        null;
      renderTrendInspector(defaultPt, spec);
    }

    function renderThreeTierComposition(current: PopulationSnapshot): void {
      if (!compositionRowsEl) return;
      if (compositionMonthLabel) {
        compositionMonthLabel.textContent = `${current.month}月`;
      }
      compositionRowsEl.replaceChildren();

      for (const year of dataset.range.years) {
        const snap = snapshots.find(
          (s) => s.year === year && s.month === current.month,
        );
        if (!snap) continue;
        const metrics = computeSnapshotMetrics(snap);
        const isCurrent = snap.ym === current.ym;

        const rowBtn = htmlEl(
          "button",
          `flex w-full flex-col gap-1.5 rounded-xl border px-3.5 py-2.5 text-left transition sm:flex-row sm:items-center sm:gap-4 ${
            isCurrent
              ? "border-alps-500 bg-alps-50/80 ring-1 ring-alps-200"
              : "border-slate-200 bg-white hover:border-alps-300 hover:bg-slate-50"
          }`,
        );
        rowBtn.type = "button";
        rowBtn.addEventListener("click", () => {
          selectYearMonth(snap.year, snap.month);
        });

        const yearLabel = htmlEl(
          "div",
          "flex w-36 shrink-0 items-baseline justify-between gap-2 sm:block",
        );
        yearLabel.append(
          htmlEl(
            "span",
            `text-xs font-bold ${isCurrent ? "text-alps-950" : "text-slate-800"}`,
            `${year}年${snap.month}月`,
          ),
          htmlEl(
            "span",
            "block font-mono text-[11px] text-slate-500",
            `${snap.total.toLocaleString("ja-JP")}人`,
          ),
        );

        const barTrack = htmlEl(
          "div",
          "flex h-6 w-full overflow-hidden rounded-lg bg-slate-100 text-[10px] font-semibold text-white",
        );

        const youthBar = htmlEl(
          "div",
          "flex items-center justify-center bg-emerald-500 transition-all",
          metrics.youthPct >= 9 ? `${metrics.youthPct.toFixed(1)}%` : "",
        );
        youthBar.style.width = `${metrics.youthPct}%`;

        const workingBar = htmlEl(
          "div",
          "flex items-center justify-center bg-[#244666] transition-all",
          `${metrics.workingPct.toFixed(1)}%`,
        );
        workingBar.style.width = `${metrics.workingPct}%`;

        const elderlyBar = htmlEl(
          "div",
          "flex items-center justify-center bg-amber-500 text-amber-950 transition-all",
          `${metrics.elderlyPct.toFixed(1)}%`,
        );
        elderlyBar.style.width = `${metrics.elderlyPct}%`;

        barTrack.append(youthBar, workingBar, elderlyBar);
        rowBtn.append(yearLabel, barTrack);
        compositionRowsEl.appendChild(rowBtn);
      }
    }

    function renderAll(): void {
      const current = getCurrentSnapshot();
      const compareSnap = resolveComparisonSnapshot(
        snapshots,
        current,
        compareMode,
      );

      if (pyramidCurrentLabel) {
        pyramidCurrentLabel.textContent = `${formatYmJa(current.ym)} 1日現在`;
      }
      if (monthSelect) {
        monthSelect.value = String(current.month);
      }
      if (timelineSlider) {
        timelineSlider.value = String(currentIndex);
      }

      if (pyramidCompareLegend && pyramidCompareNote) {
        if (compareSnap) {
          pyramidCompareLegend.classList.remove("hidden");
          pyramidCompareNote.textContent = `比較枠: ${formatYmJa(compareSnap.ym, false)}`;
        } else {
          pyramidCompareLegend.classList.add("hidden");
        }
      }

      setButtonGroupState(
        granularityButtons,
        "data-granularity-btn",
        granularity,
        "rect",
      );
      setButtonGroupState(
        compareButtons,
        "data-compare-btn",
        compareMode,
        "pill",
      );
      setButtonGroupState(axisButtons, "data-axis-btn", axisMode, "pill");
      setButtonGroupState(
        yearButtons,
        "data-year-btn",
        String(current.year),
        "compact",
      );
      setButtonGroupState(
        playModeButtons,
        "data-play-mode-btn",
        playMode,
        "compact",
      );

      renderSummaryCards(current, compareSnap);
      renderPyramid(current, compareSnap);
      renderPyramidTable(current, compareSnap);
      renderTrendSection();
      renderThreeTierComposition(current);
    }

    // Bind static controls
    for (const btn of granularityButtons) {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-granularity-btn");
        if (next === "decade" || next === "five_year" || next === "single") {
          granularity = next;
          inspectedBandId = null;
          renderAll();
        }
      });
    }

    for (const btn of compareButtons) {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-compare-btn");
        if (
          next === "none" ||
          next === "start_2017" ||
          next === "five_years_ago" ||
          next === "prev_year"
        ) {
          compareMode = next;
          renderAll();
        }
      });
    }

    for (const btn of axisButtons) {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-axis-btn");
        if (next === "fixed" || next === "auto") {
          axisMode = next;
          renderAll();
        }
      });
    }

    for (const btn of yearButtons) {
      btn.addEventListener("click", () => {
        const y = Number.parseInt(btn.getAttribute("data-year-btn") ?? "", 10);
        if (Number.isFinite(y)) {
          selectYearMonth(y, getCurrentSnapshot().month);
        }
      });
    }

    monthSelect?.addEventListener("change", () => {
      const m = Number.parseInt(monthSelect.value, 10);
      if (Number.isFinite(m)) {
        selectYearMonth(getCurrentSnapshot().year, m);
      }
    });

    timelineSlider?.addEventListener("input", () => {
      stopPlayback();
      const idx = Number.parseInt(timelineSlider.value, 10);
      if (Number.isFinite(idx) && idx >= 0 && idx < snapshots.length) {
        currentIndex = idx;
        yearMonthClampNote?.classList.add("hidden");
        renderAll();
      }
    });

    for (const btn of playModeButtons) {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-play-mode-btn");
        if (next === "annual" || next === "monthly") {
          playMode = next;
          setButtonGroupState(
            playModeButtons,
            "data-play-mode-btn",
            playMode,
            "compact",
          );
          if (playTimerId !== null) {
            stopPlayback();
          }
        }
      });
    }

    playToggleBtn?.addEventListener("click", () => {
      if (playTimerId !== null) {
        stopPlayback();
        return;
      }

      const getSequenceIndices = (): number[] => {
        if (playMode === "monthly") {
          return snapshots.map((_, i) => i);
        }
        const targetMonth = getCurrentSnapshot().month;
        const indices: number[] = [];
        for (let i = 0; i < snapshots.length; i++) {
          if (snapshots[i]?.month === targetMonth) {
            indices.push(i);
          }
        }
        return indices.length > 0 ? indices : snapshots.map((_, i) => i);
      };

      const seq = getSequenceIndices();
      let pos = seq.indexOf(currentIndex);
      if (pos === -1 || pos >= seq.length - 1) {
        pos = 0;
        currentIndex = seq[0] ?? 0;
        renderAll();
      }

      playToggleBtn.setAttribute("aria-pressed", "true");
      playToggleBtn.textContent = "⏸ 停止";
      yearMonthClampNote?.classList.add("hidden");

      const intervalMs = playMode === "annual" ? 750 : 180;
      playTimerId = window.setInterval(() => {
        pos += 1;
        const nextIdx = seq[pos];
        if (nextIdx === undefined) {
          stopPlayback();
          return;
        }
        currentIndex = nextIdx;
        renderAll();
        if (pos >= seq.length - 1) {
          stopPlayback();
        }
      }, intervalMs);
    });

    for (const btn of trendModeButtons) {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-trend-mode-btn");
        if (next === "decade" || next === "three_tier") {
          trendMode = next;
          hoveredTrendYm = null;
          renderTrendSection();
        }
      });
    }

    for (const btn of cadenceButtons) {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-cadence-btn");
        if (next === "annual_same_month" || next === "monthly") {
          trendCadence = next;
          hoveredTrendYm = null;
          renderTrendSection();
        }
      });
    }

    for (const btn of seriesButtons) {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-series-btn");
        if (next === "gender" || next === "total" || next === "share") {
          trendSeriesKind = next;
          renderTrendSection();
        }
      });
    }

    renderAll();
  </script>
</BaseLayout>
