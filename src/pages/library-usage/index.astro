---
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatJaCount } from "@/lib/library-usage-metrics";
import { libraryUsageDatasetSchema } from "@/lib/library-usage-schema";

const rawJson = readFileSync(
  path.resolve("src/data/library-usage.json"),
  "utf-8",
);
const dataset = libraryUsageDatasetSchema.parse(JSON.parse(rawJson));

const datasetIds = [
  "matsumoto-library-usage",
  "matsumoto-statistics-education",
  "matsumoto-library-overview",
  "nagano-library-survey",
];

const latestAnnual = dataset.annualRecords[dataset.annualRecords.length - 1];
const r6Annual = dataset.annualRecords.find((r) => r.fiscalYear === 2024);
const peakLoansAnnual = dataset.annualRecords.reduce((best, cur) =>
  cur.loansTotal > best.loansTotal ? cur : best,
);
const milestone1980 = dataset.decadeMilestones[0];
const latestAgeSnapshot =
  dataset.ageGroupSnapshots[dataset.ageGroupSnapshots.length - 1];

const holdings1980Multiple =
  r6Annual?.holdingsTotal && milestone1980
    ? (r6Annual.holdingsTotal / milestone1980.holdingsTotal).toFixed(1)
    : "8.4";
const loans1980Multiple = milestone1980
  ? (latestAnnual.loansTotal / milestone1980.loansTotal).toFixed(1)
  : "13.1";
const loansPerCapitaLatest = (
  latestAnnual.loansTotal / latestAnnual.population
).toFixed(1);

const takeaways = [
  {
    title: "1. 分館整備で蔵書8.4倍・貸出13倍へ拡大",
    description:
      "1980年度（2館・蔵書15.9万冊・貸出11.7万冊）から、1990〜2012年にかけての分館整備（計11館）を経て蔵書・貸出が急拡大。2015年度には個人貸出168.2万冊のピークを記録しました。",
  },
  {
    title: "2. 令和2年度の基準変更と底堅い利用",
    description:
      "令和2年度に登録者データ削除基準を「期限切れ10年以上→2年以上未更新」へ改めたため見かけ上の登録者数は半減（11.9万→5.6万人）しましたが、貸出は150万冊前後・予約は約24〜25万冊と高い水準を維持しています。",
  },
  {
    title: "3. 小中学生・子育て世代と電子化シフト",
    description:
      "年齢別（令和6年度）では7〜12歳の登録率40.8%・実利用率27.7%が突出。31〜50歳の子育て世代も高く、協働電子図書館「デジとしょ信州」は令和4→6年度で利用者が2.5倍へ伸びています。",
  },
] as const;

const embeddedJson = JSON.stringify(dataset).replace(/</g, "\\u003c");
---

<BaseLayout
  title="松本市図書館 利用状況グラフ"
  description="松本市立図書館（全11館＋2サービスポイント）の蔵書数・登録者数・貸出冊数が年代別（1980〜2025年度の長期推移、一般 vs 児童、0歳〜71歳以上の年齢階層別）でどう変化しているかをグラフで可視化。"
  datasetIds={datasetIds}
>
  <div class="space-y-8">
    <!-- Hero -->
    <section class="rounded-3xl border border-alps-200 bg-gradient-to-br from-alps-950 via-alps-900 to-alps-800 px-6 py-9 text-white sm:px-9 sm:py-11">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-alps-200 ring-1 ring-white/15">
          松本市立図書館 統計グラフ（全11館＋2SP）
        </span>
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-alps-100 ring-1 ring-white/15">
          データ更新日: {dataset.generatedAt}
        </span>
      </div>

      <h1 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">
        松本市図書館 利用状況グラフ
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-alps-100 sm:text-base">
        蔵書数・登録者数・貸出冊数が「年代別（昭和42年〜令和7年度の時代変化、直近13年間の推移、0〜6歳〜71歳以上の年齢階層別）」および「図書館別」でどの程度変わっているかを、公開統計データからグラフでわかりやすく確認できます。
      </p>

      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl bg-white/10 px-4 py-3.5 ring-1 ring-white/15">
          <p class="text-[11px] text-alps-200">蔵書数（令和6年度・全資料）</p>
          <p class="mt-0.5 text-xl font-bold">
            {r6Annual?.holdingsTotal ? formatJaCount(r6Annual.holdingsTotal, "冊") : "-"}
          </p>
          <p class="mt-1 text-[11px] text-alps-200">
            1980年度比 {holdings1980Multiple}倍（R7図書のみ{" "}
            {latestAnnual.holdingsBooks
              ? formatJaCount(latestAnnual.holdingsBooks, "冊")
              : "-"}
            ）
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 px-4 py-3.5 ring-1 ring-white/15">
          <p class="text-[11px] text-alps-200">個人貸出冊数（令和7年度）</p>
          <p class="mt-0.5 text-xl font-bold">
            {formatJaCount(latestAnnual.loansTotal, "冊")}
          </p>
          <p class="mt-1 text-[11px] text-alps-200">
            1980年度比 {loans1980Multiple}倍（市民1人あたり 約{loansPerCapitaLatest}冊）
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 px-4 py-3.5 ring-1 ring-white/15">
          <p class="text-[11px] text-alps-200">有効登録者数（令和7年度）</p>
          <p class="mt-0.5 text-xl font-bold">
            {latestAnnual.registeredTotal.toLocaleString("ja-JP")}人
          </p>
          <p class="mt-1 text-[11px] text-alps-200">
            うち児童 {latestAnnual.registeredChildren.toLocaleString("ja-JP")}人（R2に削除基準見直し）
          </p>
        </div>

        <div class="rounded-2xl bg-white/10 px-4 py-3.5 ring-1 ring-white/15">
          <p class="text-[11px] text-alps-200">貸出ピーク / 館ネットワーク</p>
          <p class="mt-0.5 text-xl font-bold">
            {formatJaCount(peakLoansAnnual.loansTotal, "冊")}
          </p>
          <p class="mt-1 text-[11px] text-alps-200">
            {peakLoansAnnual.eraLabel}最高記録 / 本館1＋分館10＋2SP
          </p>
        </div>
      </div>
    </section>

    <!-- Key Takeaways -->
    <section aria-labelledby="takeaways-heading" class="space-y-3">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2
          id="takeaways-heading"
          class="text-base font-bold text-slate-900 sm:text-lg"
        >
          30秒でわかる 年代別の変化ポイント
        </h2>
        <p class="text-xs text-slate-500">
          昭和〜令和の整備・制度変更・世代別利用の読みどころ
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        {takeaways.map((item) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <h3 class="text-sm font-bold text-alps-950">{item.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Notice & Official Links -->
    <aside
      aria-label="統計データの見方と公式案内"
      class="rounded-2xl border border-amber-200 bg-amber-50/70 px-5 py-4 text-xs leading-relaxed text-amber-950 sm:text-sm"
    >
      <p class="font-semibold text-amber-900">
        グラフを読むうえでの統計上の注記（基準変更・定義差）
      </p>
      <p class="mt-1 text-amber-900/90">{dataset.notice}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href={dataset.officialLinks.libraryTop}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg bg-amber-900 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-amber-800"
        >
          松本市図書館 公式HP ↗
        </a>
        <a
          href={dataset.officialLinks.libraryOverview}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg border border-amber-300 bg-white px-3 py-1.5 text-xs font-semibold text-amber-950 transition hover:bg-amber-100"
        >
          図書館概要（年報PDF） ↗
        </a>
        <a
          href={dataset.officialLinks.cityStats}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg border border-amber-300 bg-white px-3 py-1.5 text-xs font-semibold text-amber-950 transition hover:bg-amber-100"
        >
          松本市の統計 ↗
        </a>
        <a
          href={dataset.officialLinks.chuoRenovation}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-lg border border-amber-300 bg-white px-3 py-1.5 text-xs font-semibold text-amber-950 transition hover:bg-amber-100"
        >
          中央図書館 長寿命化改修案内 ↗
        </a>
      </div>
    </aside>

    <!-- Section 1: Long-Term Era Trends (1967-2025) -->
    <section
      aria-labelledby="longterm-heading"
      class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="font-mono text-[11px] font-semibold tracking-wider text-alps-700 uppercase">
            Long-Term Era Trends
          </p>
          <h2
            id="longterm-heading"
            class="mt-0.5 text-lg font-bold text-slate-900 sm:text-xl"
          >
            年代別の長期推移（昭和〜平成〜令和）
          </h2>
          <p class="mt-1 text-xs text-slate-600">
            1980年代からの10年刻み実績と近年の変化、および分館整備に伴う館数・蔵書・貸出の伸びを比較できます。
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div
            class="flex flex-wrap gap-1.5"
            role="group"
            aria-label="長期推移表示切替"
          >
            <button
              type="button"
              data-decade-tab="combined"
              aria-pressed="true"
              class="rounded-xl bg-alps-900 px-3 py-2 text-xs font-semibold text-white transition"
            >
              年代別 3指標比較（1980〜2025）
            </button>
            <button
              type="button"
              data-decade-tab="expansion"
              aria-pressed="false"
              class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
            >
              分館整備の歴史（1967〜2024）
            </button>
          </div>

          <div
            id="decade-scale-group"
            class="flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-50 p-1"
            role="group"
            aria-label="数値または指数切替"
          >
            <button
              type="button"
              data-decade-scale="actual"
              aria-pressed="true"
              class="rounded-lg bg-white px-2.5 py-1 text-xs font-semibold text-alps-900 shadow-xs transition"
            >
              実数
            </button>
            <button
              type="button"
              data-decade-scale="index"
              aria-pressed="false"
              class="rounded-lg px-2.5 py-1 text-xs font-medium text-slate-600 transition hover:text-slate-900"
            >
              1980年=100
            </button>
          </div>
        </div>
      </div>

      <!-- Combined 1980-2025 View -->
      <div id="decade-combined-panel" class="mt-5 space-y-4">
        <div class="grid gap-5 lg:grid-cols-12">
          <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4 lg:col-span-7">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm font-bold text-slate-900">
                蔵書数・個人貸出冊数の年代別推移
              </h3>
              <div class="flex flex-wrap items-center gap-3 text-[11px] text-slate-600">
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block h-2.5 w-2.5 rounded-sm bg-alps-500" />
                  蔵書数（全資料 / R7は図書のみ参考）
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block h-0.5 w-4 bg-emerald-600" />
                  個人貸出冊数
                </span>
              </div>
            </div>
            <div id="decade-books-loans-chart" class="mt-3" />
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4 lg:col-span-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm font-bold text-slate-900">
                登録者数の推移（R2削除基準変更を明示）
              </h3>
              <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-900">
                R1→R2 破線＝基準変更
              </span>
            </div>
            <div id="decade-registered-chart" class="mt-3" />
          </div>
        </div>

        <div
          id="decade-selected-card"
          class="rounded-2xl border border-alps-200 bg-alps-50/60 p-4"
        />
      </div>

      <!-- Branch Expansion 1967-2024 View -->
      <div id="decade-expansion-panel" class="mt-5 hidden space-y-4">
        <div class="grid gap-5 lg:grid-cols-12">
          <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-4 lg:col-span-8">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm font-bold text-slate-900">
                分館数の拡大と蔵書・貸出の推移（昭和42年〜令和6年）
              </h3>
              <div class="flex flex-wrap items-center gap-3 text-[11px] text-slate-600">
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block h-2.5 w-2.5 rounded-sm bg-alps-300" />
                  蔵書冊数
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block h-0.5 w-4 bg-alps-900" />
                  個人貸出冊数
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block h-0.5 w-4 border-t-2 border-dashed border-amber-600" />
                  館数（右軸）
                </span>
              </div>
            </div>
            <div id="expansion-chart-wrap" class="mt-3" />
          </div>

          <div
            id="expansion-detail-panel"
            class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 lg:col-span-4"
          />
        </div>
      </div>
    </section>

    <!-- Section 2: 13-Year Annual Trends (FY2013-FY2025) -->
    <section
      aria-labelledby="annual-heading"
      class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="font-mono text-[11px] font-semibold tracking-wider text-alps-700 uppercase">
            Annual Time Series (FY2013–FY2025)
          </p>
          <h2
            id="annual-heading"
            class="mt-0.5 text-lg font-bold text-slate-900 sm:text-xl"
          >
            直近13年間の毎年度推移（平成25年度〜令和7年度）
          </h2>
          <p class="mt-1 text-xs text-slate-600">
            蔵書数・登録者数・貸出冊数・市民1人あたり指標・予約相談を、全市合計または11館ごとに年単位で追跡できます。
          </p>
        </div>
      </div>

      <!-- 3 Mini Sparkline Cards -->
      <div class="mt-4 grid gap-3 sm:grid-cols-3" id="annual-sparklines-row" />

      <!-- Controls -->
      <div class="mt-5 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-1.5" role="group" aria-label="表示指標">
            <button
              type="button"
              data-annual-metric="loans"
              aria-pressed="true"
              class="rounded-xl bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
            >
              貸出冊数
            </button>
            <button
              type="button"
              data-annual-metric="holdings"
              aria-pressed="false"
              class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
            >
              蔵書数
            </button>
            <button
              type="button"
              data-annual-metric="registered"
              aria-pressed="false"
              class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
            >
              登録者数
            </button>
            <button
              type="button"
              data-annual-metric="per_capita"
              aria-pressed="false"
              class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
            >
              市民1人あたり指標
            </button>
            <button
              type="button"
              data-annual-metric="services"
              aria-pressed="false"
              class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
            >
              予約・相談・団体貸出
            </button>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <label
              for="annual-scope-select"
              class="text-xs font-semibold text-slate-700"
            >
              対象館:
            </label>
            <select
              id="annual-scope-select"
              class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-alps-950 focus:border-alps-500 focus:outline-none"
            >
              <option value="all">全市合計（11館＋2SP）</option>
              {dataset.branchProfiles.map((b) => (
                <option value={b.id}>
                  {b.name}
                  {b.formerName ? `（${b.formerName}）` : ""}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div
          id="annual-view-row"
          class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200/80 pt-3"
        >
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="表示形式">
            <button
              type="button"
              data-annual-view="total"
              aria-pressed="true"
              class="rounded-full bg-alps-900 px-3 py-1 text-xs font-semibold text-white transition"
            >
              推移グラフ（総数）
            </button>
            <button
              type="button"
              data-annual-view="children_split"
              aria-pressed="false"
              class="rounded-full border border-slate-300 bg-white px-3 py-1 text-xs font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
            >
              一般 vs 児童（積み上げ棒）
            </button>
          </div>
          <p id="annual-chart-caption" class="text-[11px] text-slate-600" />
        </div>
      </div>

      <!-- Main Chart + Selected Year Detail -->
      <div class="mt-4 grid gap-5 lg:grid-cols-12">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 lg:col-span-8">
          <div id="annual-main-chart" />
          <p class="mt-2 text-[11px] text-slate-500">
            各年度のポイント（または棒）をクリック／タップすると、右（スマホは下）の詳細パネルに前年比・児童比率・主な出来事が表示されます。
          </p>
        </div>

        <div class="lg:col-span-4">
          <div
            id="annual-detail-panel"
            class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5"
          />
        </div>
      </div>
    </section>

    <!-- Section 3: Age Group Demographics -->
    <section
      aria-labelledby="age-heading"
      class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="font-mono text-[11px] font-semibold tracking-wider text-alps-700 uppercase">
            Age Demographics (0–71+)
          </p>
          <h2
            id="age-heading"
            class="mt-0.5 text-lg font-bold text-slate-900 sm:text-xl"
          >
            利用者の年齢・年代別グラフ（0歳〜71歳以上・11区分）
          </h2>
          <p class="mt-1 text-xs text-slate-600">
            年齢階層ごとの登録率（対人口）・実利用率（当該年度に実際に貸出等の利用があった人の割合）・登録者数（館別対応）を比較できます。
          </p>
        </div>
        <span class="rounded-full bg-alps-50 px-3 py-1 text-xs font-semibold text-alps-900 ring-1 ring-alps-200">
          最新：{latestAgeSnapshot.eraLabel}（{latestAgeSnapshot.asOf}）
        </span>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-4">
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="年齢別指標切替">
          <button
            type="button"
            data-age-metric="regRate"
            aria-pressed="true"
            class="rounded-xl bg-alps-900 px-3 py-1.5 text-xs font-semibold text-white transition"
          >
            登録率（対人口 %）
          </button>
          <button
            type="button"
