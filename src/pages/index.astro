---
import { getCollection } from "astro:content";
import ServiceCard from "@/components/ServiceCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allServices = await getCollection("services");
const publishedServices = allServices
  .map((entry) => entry.data)
  .filter(
    (service) => service.status === "published" || service.status === "beta",
  )
  .sort((a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""));

const datasets = await getCollection("datasets");

const officialLinks = [
  {
    name: "松本市オープンデータ（公式）",
    description:
      "松本市が公開する行政データ・施設台帳・統計情報などの一次配布元。",
    url: "https://www.city.matsumoto.nagano.jp/soshiki/20/4058.html",
    license: "原則 CC BY 4.0（一部 CC BY 3.0）",
  },
  {
    name: "長野県オープンデータ",
    description: "信州山のグレーディングなど県域のオープンデータ。",
    url: "https://www.pref.nagano.lg.jp/dx-suishin/kensei/tokei/opendata/index.html",
    license: "CC BY 4.0 等",
  },
  {
    name: "Project PLATEAU（国土交通省）",
    description: "松本市を含む 3D 都市モデル（CityGML / 3D Tiles）。",
    url: "https://www.mlit.go.jp/plateau/",
    license: "政府標準利用規約 2.0",
  },
];
---

<BaseLayout title="松本市オープンデータ活用サイト">
  <section class="relative overflow-hidden rounded-3xl border border-alps-200 bg-gradient-to-br from-alps-950 via-alps-900 to-alps-800 px-6 py-12 text-white sm:px-10 sm:py-16">
    <div class="max-w-2xl">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 font-mono text-xs text-alps-200 ring-1 ring-white/15">
        Matsumoto Open Data × Civic Tech
      </p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        松本市のオープンデータを、<br class="hidden sm:inline" />
        1ページの小さなサービスに。
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-alps-100 sm:text-base">
        松本市や北アルプス地域にまつわる公開データを整備し、すぐに使える1ページ完結型のミニサービスとして公開する実験場です。
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="#services"
          class="inline-flex items-center rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-alps-950 transition hover:bg-alps-100"
        >
          サービスを見る
        </a>
        <a
          href="/data/"
          class="inline-flex items-center rounded-xl bg-white/10 px-4 py-2.5 text-sm font-semibold text-white ring-1 ring-white/25 transition hover:bg-white/20"
        >
          データ一覧を見る
        </a>
      </div>
    </div>
  </section>

  <section id="services" class="mt-14 scroll-mt-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">
          公開中のサービス
        </h2>
        <p class="mt-1 text-sm text-slate-600">
          1つのデータテーマに特化した、1ページ完結型のミニサービス群です。
        </p>
      </div>
      <a
        href="https://github.com/raichonomichi/matsumoto-opendata/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-alps-700 hover:text-alps-900 hover:underline"
      >
        検討中のアイデアを見る（GitHub Issues）→
      </a>
    </div>

    {publishedServices.length > 0 ? (
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {publishedServices.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    ) : (
      <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-alps-50/50 p-8 text-center">
        <p class="text-base font-semibold text-slate-800">
          現在、最初のサービスを準備中です
        </p>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-relaxed text-slate-600">
          山小屋レジストリ、ごみ収集カレンダー、防災カルテなどのアイデアを GitHub Issues で整理しながら順次実装を進めています。
        </p>
        <div class="mt-5">
          <a
            href="https://github.com/raichonomichi/matsumoto-opendata/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-xl bg-alps-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-alps-800"
          >
            GitHub Issues でアイデア一覧を見る
          </a>
        </div>
      </div>
    )}
  </section>

  <section id="about-opendata" class="mt-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <h2 class="text-xl font-bold tracking-tight text-slate-900">
        松本市オープンデータについて
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">
        オープンデータとは、自治体や公的機関が保有するデータを、機械判読に適した形式で、二次利用可能なルール（オープンライセンス）のもと公開したものです。松本市では生活衛生・防災・観光・交通などのデータが公開されており、出典を明記することで商用・非商用を問わず活用できます。
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {officialLinks.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:border-alps-400 hover:bg-white"
          >
            <p class="text-sm font-semibold text-alps-900 group-hover:text-alps-700">
              {item.name} ↗
            </p>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
              {item.description}
            </p>
            <p class="mt-2 inline-block rounded bg-white px-2 py-0.5 text-[11px] font-medium text-slate-600 ring-1 ring-slate-200">
              {item.license}
            </p>
          </a>
        ))}
      </div>

      <div class="mt-6 rounded-xl bg-alps-50 p-4 text-xs leading-relaxed text-slate-700">
        <span class="font-semibold text-alps-900">ライセンス表記の方針:</span>
        本サイトでは、利用するデータセットごとに配布元・ライセンス（CC BY 4.0 / CC BY 3.0 / 政府標準利用規約 2.0 等）・確認日をメタデータとして一元管理し、各サービスページのフッターおよび
        <a href="/data/" class="font-medium text-alps-800 underline underline-offset-2">
          データ一覧
        </a>
        に明記します。
      </div>
    </div>
  </section>

  <section class="mt-14">
    <div class="flex flex-col items-start justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:flex-row sm:items-center sm:p-8">
      <div>
        <h2 class="text-lg font-bold text-slate-900">
          データカタログ（使用データ一覧）
        </h2>
        <p class="mt-1 text-sm text-slate-600">
          現在 {datasets.length} 件のデータソースを登録済み。各サービスで利用しているオープンデータの出典・ライセンス・更新状況を確認できます。
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-2">
        <a
          href="/data/"
          class="rounded-xl bg-alps-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-alps-800"
        >
          データ一覧へ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
