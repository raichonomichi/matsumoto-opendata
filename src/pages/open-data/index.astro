---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const datasets = await getCollection("datasets");

const principles = [
  {
    number: "01",
    title: "二次利用可能なライセンス",
    description:
      "商用・非商用を問わず、出典を明記すれば誰でも自由にコピー・加工・再配布できるルール（オープンライセンス）で公開されています。",
  },
  {
    number: "02",
    title: "機械判読に適した形式",
    description:
      "人間が見るだけの画像やPDFだけでなく、CSV・Excel・JSON・GTFS-JP など、プログラムや表計算ソフトでそのまま処理しやすい形式で提供されます。",
  },
  {
    number: "03",
    title: "無償で利用できる",
    description:
      "市民・企業・開発者・研究者を問わず、利用料なしにアクセスでき、新しいサービスや調査・可視化の材料として活用できます。",
  },
] as const;

const categories = [
  {
    title: "暮らし・生活衛生",
    description:
      "旅館業・飲食店などの営業許可台帳、公共施設一覧、AED設置場所、ごみ収集関連など、日々の生活や観光に関わる行政台帳データ。",
  },
  {
    title: "交通・モビリティ（GTFS-JP）",
    description:
      "ぐるっとまつもとバス等の路線・停留所・時刻表を、日本の標準的なバス情報フォーマット「GTFS-JP」形式で公開。",
  },
  {
    title: "防災・地図・3D都市モデル",
    description:
      "避難所情報、公開型GIS「松本デジタルまっぷ」の空間データ、国土交通省「Project PLATEAU」による松本市の3D都市モデルなど。",
  },
  {
    title: "山岳・県域データ",
    description:
      "長野県が公開する「信州 山のグレーディング一覧表」をはじめ、北アルプス・乗鞍・美ヶ原周辺の登山や観光に役立つ広域データ。",
  },
] as const;

const officialLinks = [
  {
    name: "松本市オープンデータ（公式）",
    description:
      "松本市が公開する行政データ・施設台帳・統計情報などの一次配布元。",
    url: "https://www.city.matsumoto.nagano.jp/soshiki/20/4058.html",
    license: "原則 CC BY 4.0（一部 CC BY 3.0）",
  },
  {
    name: "松本デジタルまっぷ（公開型GIS）",
    description:
      "都市計画・防災・くらしに関する地図情報を閲覧できる松本市の公開型GIS。",
    url: "https://www.city.matsumoto.nagano.jp/soshiki/70/65242.html",
    license: "松本市公式ポータル規約に準拠",
  },
  {
    name: "松本市 バス情報データ（GTFS-JP）",
    description:
      "ぐるっとまつもとバス等の路線・時刻表データ（GTFSデータリポジトリ公開）。",
    url: "https://www.city.matsumoto.nagano.jp/soshiki/222/88191.html",
    license: "CC BY 4.0",
  },
  {
    name: "長野県オープンデータ",
    description: "信州山のグレーディングなど県域のオープンデータ。",
    url: "https://www.pref.nagano.lg.jp/dx-suishin/kensei/tokei/opendata/index.html",
    license: "CC BY 4.0 等",
  },
  {
    name: "Project PLATEAU（国土交通省）",
    description:
      "松本市を含む 3D 都市モデル（CityGML / 3D Tiles）。G空間情報センター等で配布。",
    url: "https://www.mlit.go.jp/plateau/",
    license: "政府標準利用規約 2.0",
  },
] as const;
---

<BaseLayout
  title="松本市のオープンデータとは"
  description="松本市や長野県が公開しているオープンデータの基本、主なデータ分野、一次配布元ポータル、ライセンスや実務上の注意点について解説します。"
>
  <article class="space-y-12">
    <header>
      <p class="font-mono text-xs font-semibold tracking-wider text-alps-700 uppercase">
        Matsumoto Open Data
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
        松本市のオープンデータとは
      </h1>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base">
        <strong>オープンデータ</strong>とは、自治体や公的機関が保有するデータを、機械判読に適した形式で、二次利用可能なルール（オープンライセンス）のもと公開したものです。松本市では暮らし・交通・防災・観光などのデータが公開されており、出典を明記することで商用・非商用を問わず活用できます。
      </p>
    </header>

    <section aria-labelledby="principles-heading">
      <h2 id="principles-heading" class="text-xl font-bold tracking-tight text-slate-900">
        オープンデータの基本3条件
      </h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-3">
        {principles.map((item) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <p class="font-mono text-xs font-semibold text-alps-700">
              {item.number}
            </p>
            <h3 class="mt-2 text-base font-bold text-slate-900">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="categories-heading">
      <h2 id="categories-heading" class="text-xl font-bold tracking-tight text-slate-900">
        松本市・周辺地域で公開されている主なデータ分野
      </h2>
      <p class="mt-2 text-sm text-slate-600">
        松本市および長野県・国の公開データから、暮らしや旅に役立つ多様な情報が提供されています。
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {categories.map((cat) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="text-base font-bold text-slate-900">{cat.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              {cat.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="portals-heading">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h2 id="portals-heading" class="text-xl font-bold tracking-tight text-slate-900">
          主な一次配布元ポータル
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          元データのダウンロードや最新の利用規約は、以下の公式配布元から確認できます。
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {officialLinks.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:border-alps-400 hover:bg-white"
            >
              <p class="text-sm font-semibold text-alps-900 group-hover:text-alps-700">
                {item.name} ↗
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                {item.description}
              </p>
              <p class="mt-2 inline-block rounded bg-white px-2 py-0.5 text-[11px] font-medium text-slate-600 ring-1 ring-slate-200">
                {item.license}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="license-heading">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h2 id="license-heading" class="text-xl font-bold tracking-tight text-slate-900">
          ライセンスと実務上の注意点
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          松本市・長野県・国のオープンデータは主に <strong>CC BY 4.0</strong>、<strong>CC BY 3.0</strong>、<strong>政府標準利用規約 2.0</strong> のいずれかで公開されており、いずれも「出典を明記すれば商用利用・加工が可能」という点は共通しています。一方、実際のサービス開発では次の点に注意が必要です。
        </p>

        <ul class="mt-5 space-y-3 text-sm leading-relaxed text-slate-700">
          <li class="rounded-xl bg-slate-50 p-4">
            <span class="font-semibold text-slate-900">配布経路ごとのライセンス差異を確認する:</span>
            同じ松本市のデータでも、公式ホームページと LinkData.org 等の外部配布先で CC BY 4.0 と CC BY 3.0 が混在するケースがあるため、データセット単位で確認が必要です。
          </li>
          <li class="rounded-xl bg-slate-50 p-4">
            <span class="font-semibold text-slate-900">有効期限と最新性を意識する:</span>
            バス時刻データ（GTFS-JP）にはダイヤ有効期間があり、営業許可台帳も随時更新されます。利用時は確認日・有効期限を明示し、最新情報は公式案内と併せて確認することが重要です。
          </li>
          <li class="rounded-xl bg-slate-50 p-4">
            <span class="font-semibold text-slate-900">用途に応じた整形・キュレーションが必要:</span>
            施設台帳には市街地のホテルと山岳エリアの山小屋が混在しているなど、元データのままでは一般利用者には見づらいことが多いため、目的に合わせた抽出や他データとの結合が価値を生みます。
          </li>
        </ul>

        <div class="mt-6 rounded-xl bg-alps-50 p-4 text-xs leading-relaxed text-slate-700">
          <span class="font-semibold text-alps-900">本サイトのライセンス表記方針:</span>
          現在 {datasets.length} 件のデータソースをメタデータとして一元管理し、配布元・ライセンス・確認日・有効期限を各サービスページのフッターおよび
          <a href="/data/" class="font-medium text-alps-800 underline underline-offset-2">
            データ一覧
          </a>
          に必ず明記しています。
        </div>
      </div>
    </section>

    <section aria-labelledby="next-steps-heading">
      <div class="rounded-2xl border border-alps-200 bg-alps-50/70 p-6 sm:p-8">
        <h2 id="next-steps-heading" class="text-lg font-bold text-slate-900">
          オープンデータを、暮らしと旅のツールへ
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-700">
          公開されたデータを市民目線で使いやすいツールへと形にする取り組みが「Civic Tech（シビックテック）」です。本サイトで使用しているデータの詳細や、公開中のツールもあわせてご覧ください。
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/"
            class="inline-flex items-center rounded-xl bg-alps-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-alps-800"
          >
            公開中のサービスを見る
          </a>
          <a
            href="/data/"
            class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
          >
            使用データ一覧を見る
          </a>
          <a
            href="/civic-tech/"
            class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-alps-400 hover:text-alps-900"
          >
            Civic Techとは
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
