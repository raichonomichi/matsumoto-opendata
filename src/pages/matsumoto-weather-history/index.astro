---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { comparisonYears } from "@/lib/matsumoto-weather-history";
---

<BaseLayout
  title="松本の過去の今日の気温"
  description="松本観測所で1年前・5年前・10年前の今日に観測された、日最低気温と日最高気温を比べられます。"
  datasetIds={["jma-matsumoto-daily-temperature"]}
>
  <section class="mx-auto max-w-4xl py-6 sm:py-10">
    <header>
      <h1 class="text-3xl font-bold tracking-tight text-alps-950 sm:text-4xl">
        松本の過去の今日の気温
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
        気象庁の松本特別地域気象観測所の日別観測値です。
      </p>
    </header>

    <div id="weather-history" class="mt-8" hidden>
      <p class="text-sm font-medium text-slate-600">
        基準日 <time id="weather-today" class="ml-1 font-semibold text-slate-900"></time>
        （日本時間）
      </p>

      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {
          comparisonYears.map((yearsAgo) => (
            <article
              data-years-ago={yearsAgo}
              class="rounded-2xl border border-slate-200 bg-white p-5"
            >
              <h2 class="text-xl font-bold text-alps-950">{yearsAgo}年前</h2>
              <div class="mt-1 flex flex-wrap items-baseline gap-x-2 text-sm">
                <a
                  data-observation-source
                  class="font-medium text-alps-800 underline decoration-alps-300 underline-offset-2"
                  href="https://www.data.jma.go.jp/risk/obsdl/"
                >
                  <time data-observation-date></time>
                </a>
                <span data-target-date class="text-slate-600" hidden></span>
                <span data-alternate class="font-medium text-slate-600" hidden>代替日</span>
              </div>
              <dl data-temperatures class="mt-5 grid grid-cols-2 gap-3">
                <div class="rounded-xl bg-sky-50 p-2.5 text-sky-950">
                  <dt class="text-xs font-medium">最低気温</dt>
                  <dd data-minimum class="mt-1 whitespace-nowrap text-lg font-semibold tabular-nums"></dd>
                </div>
                <div class="rounded-xl bg-orange-50 p-2.5 text-orange-950">
                  <dt class="text-xs font-medium">最高気温</dt>
                  <dd data-maximum class="mt-1 whitespace-nowrap text-lg font-semibold tabular-nums"></dd>
                </div>
              </dl>
              <p data-no-record class="mt-5 text-sm font-medium text-slate-700" hidden>記録なし</p>
              <p data-provisional class="mt-3 text-xs text-slate-600" hidden>準正常値を含みます。</p>
            </article>
          ))
        }
      </div>

      <p class="mt-4 text-sm leading-relaxed text-slate-600">
        気温がそろわない日は、前後7日で最も近い観測日を表示します。同じ日数なら前の日を優先します。
      </p>
    </div>
    <noscript>
      <p class="mt-8 text-sm text-slate-700">
        気温の表示にはJavaScriptが必要です。
        <a class="underline" href="https://www.data.jma.go.jp/risk/obsdl/">気象庁で観測データを見る</a>
      </p>
    </noscript>
  </section>
</BaseLayout>

<script>
  import weatherData from "@/data/matsumoto-weather-history.json";
  import { getWeatherComparisons } from "@/lib/matsumoto-weather-history";

  function formatDate(ymd: string): string {
    const [year, month, day] = ymd.split("-").map(Number);
    return `${year}年${month}月${day}日`;
  }

  function observationSource(date: string): string {
    const [year, month, day] = date.split("-");
    const url = new URL("https://www.data.jma.go.jp/stats/etrn/view/daily_s1.php");
    url.search = new URLSearchParams({
      prec_no: "48",
      block_no: "47618",
      year,
      month,
      day,
      view: "p1",
    }).toString();
    return url.href;
  }

  const section = document.querySelector<HTMLElement>("#weather-history");
  const todayLabel = document.querySelector<HTMLTimeElement>("#weather-today");

  function render() {
    if (!section || !todayLabel) return;
    const { today, comparisons } = getWeatherComparisons(weatherData, new Date());
    todayLabel.dateTime = today;
    todayLabel.textContent = formatDate(today);

    for (const { yearsAgo, requestedOn, observation } of comparisons) {
      const card = section.querySelector(`[data-years-ago="${yearsAgo}"]`);
      const source = card?.querySelector<HTMLAnchorElement>(
        "[data-observation-source]",
      );
      const observationDate = card?.querySelector<HTMLTimeElement>(
        "[data-observation-date]",
      );
      const targetDate = card?.querySelector<HTMLElement>("[data-target-date]");
      const alternate = card?.querySelector<HTMLElement>("[data-alternate]");
      const temperatures = card?.querySelector<HTMLElement>("[data-temperatures]");
      const min = card?.querySelector<HTMLElement>("[data-minimum]");
      const max = card?.querySelector<HTMLElement>("[data-maximum]");
      const noRecord = card?.querySelector<HTMLElement>("[data-no-record]");
      const provisional = card?.querySelector<HTMLElement>("[data-provisional]");
      if (
        !source ||
        !observationDate ||
        !targetDate ||
        !alternate ||
        !temperatures ||
        !min ||
        !max ||
        !noRecord ||
        !provisional
      ) {
        continue;
      }

      source.hidden = !observation;
      targetDate.hidden = !!observation;
      temperatures.hidden = !observation;
      noRecord.hidden = !!observation;
      alternate.hidden = !observation || observation.date === requestedOn;
      provisional.hidden = !observation?.temperatures.provisional;
      if (observation) {
        source.href = observationSource(observation.date);
        observationDate.dateTime = observation.date;
        observationDate.textContent = formatDate(observation.date);
        min.textContent = `${observation.temperatures.minC.toFixed(1)}℃`;
        max.textContent = `${observation.temperatures.maxC.toFixed(1)}℃`;
      } else {
        targetDate.textContent = formatDate(requestedOn);
      }
    }
    section.hidden = false;
  }

  render();
  window.addEventListener("pageshow", render);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") render();
  });
</script>
