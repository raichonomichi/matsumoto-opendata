---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const datasets = (await getCollection("datasets"))
  .map((entry) => entry.data)
  .sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
  title="データ一覧"
  description="松本市オープンデータ活用サイトの各サービスで参照・整備しているオープンデータセットの出典・ライセンス・更新状況一覧。"
>
  <div class="space-y-12">
    <section>
      <p class="font-mono text-xs font-semibold tracking-wider text-alps-700 uppercase">
        Data Catalog
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
        データ一覧
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
        本サイトの各サービスで利用するオープンデータの出典・ライセンス・更新状況を一覧化しています。なお、本サイトは1ページ完結型のミニサービス提供に特化しており、JSON API としてのデータ公開は非対応です。元データの取得は各一次配布元をご利用ください。
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900">
        登録データセット（{datasets.length}件）
      </h2>
      <div class="mt-5 space-y-4">
        {datasets.map((ds) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="text-lg font-bold text-slate-900">{ds.name}</h3>
                <p class="mt-0.5 font-mono text-xs text-slate-500">
                  ID: {ds.id} / 提供: {ds.provider}
                </p>
              </div>
              <a
                href={ds.licenseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-full bg-alps-50 px-3 py-1 text-xs font-semibold text-alps-800 ring-1 ring-alps-200 hover:bg-alps-100"
              >
                {ds.license}
              </a>
            </div>

            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {ds.description}
            </p>

            <dl class="mt-4 grid gap-3 border-t border-slate-100 pt-4 text-xs sm:grid-cols-3">
              <div>
                <dt class="font-medium text-slate-500">配布形式</dt>
                <dd class="mt-0.5 text-slate-800">{ds.format.join(", ")}</dd>
              </div>
              <div>
                <dt class="font-medium text-slate-500">更新頻度</dt>
                <dd class="mt-0.5 text-slate-800">{ds.updateFrequency}</dd>
              </div>
              <div>
                <dt class="font-medium text-slate-500">確認・更新日</dt>
                <dd class="mt-0.5 text-slate-800">
                  {ds.updatedAt}
                  {ds.validUntil && `（有効期限: ${ds.validUntil}）`}
                </dd>
              </div>
            </dl>

            <div class="mt-4 flex flex-wrap items-center gap-3 text-xs">
              <a
                href={ds.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-alps-700 underline underline-offset-2 hover:text-alps-900"
              >
                一次配布元を見る ↗
              </a>
            </div>

            <p class="mt-3 text-xs text-slate-500">出典表記: {ds.attribution}</p>
            {ds.notes && (
              <p class="mt-1.5 text-xs text-slate-500">備考: {ds.notes}</p>
            )}
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
