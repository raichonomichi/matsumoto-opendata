---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const datasets = (await getCollection("datasets"))
  .map((entry) => entry.data)
  .sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
  title="データ・API一覧"
  description="松本市オープンデータ活用サイトで参照・整備しているデータセット一覧と、静的 JSON API の利用ガイド。"
>
  <div class="space-y-12">
    <section>
      <p class="font-mono text-xs font-semibold tracking-wider text-alps-700 uppercase">
        Data Catalog & Static JSON API
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
        データ・API一覧
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
        本サイトで利用するオープンデータの出典・ライセンス・更新状況を一覧化しています。加工・正規化したデータセットは、他の開発者もそのまま利用できるよう
        <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-alps-900">/api/v1/</code>
        配下で静的 JSON として公開します。
      </p>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-alps-50/60 p-6">
      <h2 class="text-lg font-bold text-slate-900">静的 JSON API の利用方法</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
        <li>
          エンドポイントは <code class="font-mono text-xs">https://modata.raichonomichi.net/api/v1/...</code> 配下に配置されます。
        </li>
        <li>
          CORS（<code class="font-mono text-xs">Access-Control-Allow-Origin: *</code>）を許可しているため、ブラウザから直接 <code class="font-mono text-xs">fetch</code> 可能です。
        </li>
        <li>
          二次利用時は、各データセットに記載されたライセンスおよび出典表記を遵守してください。
        </li>
      </ul>

      <div class="mt-4 overflow-x-auto rounded-xl bg-slate-900 p-4 font-mono text-xs text-slate-100">
        <pre><code>curl -s https://modata.raichonomichi.net/api/v1/catalog.json | jq .</code></pre>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900">
        登録データセット（{datasets.length}件）
      </h2>
      <div class="mt-5 space-y-4">
        {datasets.map((ds) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="text-lg font-bold text-slate-900">{ds.name}</h3>
                <p class="mt-0.5 font-mono text-xs text-slate-500">
                  ID: {ds.id} / 提供: {ds.provider}
                </p>
              </div>
              <a
                href={ds.licenseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-full bg-alps-50 px-3 py-1 text-xs font-semibold text-alps-800 ring-1 ring-alps-200 hover:bg-alps-100"
              >
                {ds.license}
              </a>
            </div>

            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {ds.description}
            </p>

            <dl class="mt-4 grid gap-3 border-t border-slate-100 pt-4 text-xs sm:grid-cols-3">
              <div>
                <dt class="font-medium text-slate-500">配布形式</dt>
                <dd class="mt-0.5 text-slate-800">{ds.format.join(", ")}</dd>
              </div>
              <div>
                <dt class="font-medium text-slate-500">更新頻度</dt>
                <dd class="mt-0.5 text-slate-800">{ds.updateFrequency}</dd>
              </div>
              <div>
                <dt class="font-medium text-slate-500">確認・更新日</dt>
                <dd class="mt-0.5 text-slate-800">
                  {ds.updatedAt}
                  {ds.validUntil && `（有効期限: ${ds.validUntil}）`}
                </dd>
              </div>
            </dl>

            <div class="mt-4 flex flex-wrap items-center gap-3 text-xs">
              <a
                href={ds.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-alps-700 underline underline-offset-2 hover:text-alps-900"
              >
                一次配布元を見る ↗
              </a>
              {ds.apiPath && (
                <a
                  href={ds.apiPath}
                  class="rounded-md bg-slate-100 px-2.5 py-1 font-mono text-slate-800 hover:bg-alps-100 hover:text-alps-900"
                >
                  API: {ds.apiPath}
                </a>
              )}
            </div>

            <p class="mt-3 text-xs text-slate-500">出典表記: {ds.attribution}</p>
            {ds.notes && (
              <p class="mt-1.5 text-xs text-slate-500">備考: {ds.notes}</p>
            )}
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
